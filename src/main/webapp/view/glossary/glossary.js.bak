            console.log('lastUpdated_userID:', g.lastUpdated_userID);
            console.log('created_Datetime:', g.created_Datetime);
            console.log('last_Updated_Datetime:', g.last_Updated_Datetime);
            console.log('confidentiality_Rating:', g.confidentiality_Rating);
            console.log('integrity_Rating:', g.integrity_Rating);
            console.log('availability_Rating:', g.availability_Rating);
            console.log('kde:', g.kde);
            
            // Check for camelCase variations
            console.log('=== CAMELCASE VARIATIONS ===');
            console.log('createdById:', g.createdById);
            console.log('lastUpdatedUserId:', g.lastUpdatedUserId);
            console.log('createdDatetime:', g.createdDatetime);
