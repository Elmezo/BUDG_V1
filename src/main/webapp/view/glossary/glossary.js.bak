(function() {
    let _canEditObject = false; // Whether user can normally edit this object (without auto CR restriction)
    let _hasActiveAutoCR = false; // Whether an active auto CR is blocking edits
    
    function parseId() {
        const parts = window.location.pathname.split('/').filter(Boolean);
        const idx = parts.indexOf('glossary');
        if (idx === -1 || parts.length < idx + 2) return null;
        const id = parseInt(parts[idx + 1], 10);
        return Number.isNaN(id) ? null : id;
    }

    let _glossaryGuestCache = null;
    async function isGuestVisitorForGlossary() {
        if (_glossaryGuestCache !== null) {
            return _glossaryGuestCache;
        }
        try {
            const resp = await fetch('/api/me', { method: 'GET', credentials: 'include' });
            if (!resp.ok) {
                _glossaryGuestCache = true;
                return _glossaryGuestCache;
            }
            const me = await resp.json().catch(() => ({}));
            const role = (me.role || '').toString().toLowerCase();
            const isAuthenticated = me.authenticated === true;
            const isGuestRole = role.includes('guest');
            _glossaryGuestCache = !isAuthenticated || isGuestRole;
            return _glossaryGuestCache;
        } catch (_) {
            _glossaryGuestCache = true;
            return _glossaryGuestCache;
        }
    }

    function renderGlossaryGuestAccessDenied(container, glossaryId, segmentName, segmentId) {
        if (!container) return;
        const title = (window.I18n && window.I18n.t && window.I18n.t('error.segmentAccess.title')) || 'Cannot access this item';
        const message = (window.I18n && window.I18n.t && window.I18n.t('error.segmentAccess.message')) || 'This item is not available for guest users.';
        const code = 'ERR-SEGMENT-NOT-ENTERPRISE';
        const segmentLabel = segmentName || ((segmentId !== undefined && segmentId !== null) ? `ID ${segmentId}` : 'Unknown');
        const esc = (text) => {
            if (text == null) return '';
            const div = document.createElement('div');
            div.textContent = String(text);
            return div.innerHTML;
        };
        container.innerHTML = `
            <div class="view-section" style="grid-column: 1/-1; text-align: center; padding: 3rem 1rem;">
                <div class="access-denied-title" style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.75rem;">${esc(title)}</div>
                <div class="access-denied-message" style="margin-bottom: 1.25rem; color: var(--text-muted, #4b5563);">
                    ${esc(message)}
                </div>
                <div class="access-denied-details" style="font-size: 0.95rem; color: var(--text-muted, #6b7280);">
                    <div style="margin-bottom: 0.5rem;">Segment: <strong>${esc(segmentLabel)}</strong></div>
                    <div>Error code: <code>${code}</code></div>
                </div>
            </div>
        `;
    }

     // Robust hide function: hides existing elements and watches for elements added later
     function hideEditControls() {
         // Hide the edit dropdown for unauthorized users
         if (window.EditDropdown) {
             window.EditDropdown.hideEditControls();
         }
         const ids = [
             'editBtn',
             'editBtn2',
             'editStakeholdersBtn'
         ];
         ids.forEach(function(id){
             const el = document.getElementById(id);
             if (el) {
                 try {
                     el.style.setProperty('display', 'none', 'important');
                 } catch (_) {
                     el.style.display = 'none';
                 }
                 el.setAttribute('data-hidden-by', 'hideEditControls');
                 try { if (typeof el.blur === 'function') el.blur(); } catch(_) {}
             }
         });
         try {
             document.querySelectorAll('[data-action="edit"]').forEach(function(el){
                 try {
                     el.style.setProperty('display', 'none', 'important');
                 } catch (_) {
                     el.style.display = 'none';
                 }
                 el.setAttribute('data-hidden-by', 'hideEditControls');
                 try { if (typeof el.blur === 'function') el.blur(); } catch(_) {}
             });
         } catch (err) {
             console.error('hideEditControls error:', err);
         }
     }

     // ensure: run hideEditControls immediately and observe DOM for new matching nodes
     function ensureHideEditControls(options = {}) {
         const timeout = typeof options.timeout === 'number' ? options.timeout : 15000; // stop observing after 15s
         hideEditControls();

         // If the page adds elements later (e.g. via XHR/templating), observe and hide them when they appear
         const observer = new MutationObserver(mutations => {
             let found = false;
             for (const m of mutations) {
                 for (const node of m.addedNodes) {
                     if (!(node instanceof Element)) continue;
                     if (node.matches && node.matches('#editBtn,#editBtn2,#editStakeholdersBtn,[data-action="edit"]')) {
                         found = true;
                     } else if (node.querySelector && node.querySelector('#editBtn,#editBtn2,#editStakeholdersBtn,[data-action="edit"]')) {
                         found = true;
                     }
                 }
             }
             if (found) hideEditControls();
         });

         // observe body (or documentElement) for subtree changes
         const target = document.body || document.documentElement;
         try {
             observer.observe(target, { childList: true, subtree: true });
         } catch (e) {
             // ignore observe errors
         }

         // Stop observing after timeout to avoid long-lived observer
         setTimeout(() => {
             try { observer.disconnect(); } catch(_) {}
         }, timeout);
     }

     // Auto-run on load (safe) - but check auth first
     if (document.readyState === 'loading') {
         document.addEventListener('DOMContentLoaded', () => hideEditsIfUnauthenticated());
     } else {
         hideEditsIfUnauthenticated();
     }

     // ---- Optional: integrate with your auth-check function ----
     // Replace calls to hideEditControls() with ensureHideEditControls() to get the robust behavior:

	async function hideEditsIfUnauthenticated() {
		try {
			const id = parseId();
			if (!id) {
				console.log('[Glossary] No ID found - hiding edit controls');
				ensureHideEditControls();
				return;
			}

			// Use the shared utility function to check if user can edit this object
			if (window.checkCanEditObject) {
				const editCheck = await window.checkCanEditObject('Glossary', id);
				const canEditObject = editCheck.canEdit;
				const isAdmin = editCheck.isAdmin;
				
				console.log('[Glossary] Can edit object?', canEditObject, '(isAdmin:', isAdmin, ', isStakeholder:', editCheck.isStakeholder, ')');
				
				// Store canEditObject at module level for stakeholder tab redirect
				_canEditObject = canEditObject;
				
				// Show edit controls only if user can edit this object
				if (canEditObject) {
					console.log('[Glossary] User can edit this object - showing edit controls');
					showEditControls();
				} else {
					console.log('[Glossary] User cannot edit this object - hiding edit controls');
					ensureHideEditControls();
				}
			} else {
				// Fallback to old method if utility function not available
				const meResp = await fetch('/api/me', { method: 'GET', credentials: 'include' });
				if (!meResp.ok) { 
					console.log('API /api/me failed:', meResp.status);
					ensureHideEditControls(); 
					return; 
				}
				const me = await meResp.json();
				const role = (me.role || me.Role || me.userRole || '').toString().toLowerCase();
				const isAdmin = role === 'admin' || role === 'super admin' || role === 'super-admin' || role === 'super_admin' || role === 'suber admin';
				
				// Check permissions for Glossary facet
				let hasEditPermission = isAdmin;
				if (!isAdmin) {
					try {
						const permResp = await fetch('/api/user/permissions/Glossary', { 
							method: 'GET', 
							credentials: 'include' 
						});
						if (permResp.ok) {
							const permData = await permResp.json();
							if (permData.success) {
								hasEditPermission = permData.canEdit === true || permData.isAdmin === true;
							}
						}
					} catch (permError) {
						console.warn('[Glossary] Error checking permissions:', permError);
					}
				}
				
				if (!hasEditPermission) {
					ensureHideEditControls();
				} else {
					showEditControls();
				}
			}
		} catch(e) {
			console.log('Error in hideEditsIfUnauthenticated:', e);
			ensureHideEditControls();
		}
	}

	function showEditControls() {
		const ids = [
			'editBtn',
			'editBtn2',
			'editStakeholdersBtn'
		];
		ids.forEach(function(id){
			const el = document.getElementById(id);
			if (el) {
				el.style.display = '';
				el.style.setProperty('display', '', 'important');
				el.removeAttribute('data-hidden-by');
			}
		});
		try {
			document.querySelectorAll('[data-action="edit"]').forEach(function(el){
				el.style.display = '';
				el.style.setProperty('display', '', 'important');
				el.removeAttribute('data-hidden-by');
			});
		} catch(_) {}
		console.log('Edit controls shown for admin user');
	}

    function escapeHtml(str) {
        if (str == null) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function _richHtml(val) {
        if (val == null || String(val).trim() === '') return '<span class="empty">-</span>';
        var s = String(val);
        if (!/<[a-z][\s\S]*>/i.test(s)) return escapeHtml(s);
        var t = document.createElement('template'); t.innerHTML = s;
        t.content.querySelectorAll('script,style,iframe,object,embed,link,meta').forEach(function(e){e.remove();});
        t.content.querySelectorAll('*').forEach(function(el){
            Array.from(el.attributes).forEach(function(a){
                if(a.name.toLowerCase().indexOf('on')===0) el.removeAttribute(a.name);
                if((a.name==='href'||a.name==='src')&&/^\s*javascript:/i.test(a.value)) el.removeAttribute(a.name);
            });
        });
        return '<div class="rich-html-content">' + t.innerHTML + '</div>';
    }

    function renderItem(label, valueHtml) {
        return `<div class=\"view-item\"><div class=\"view-label\">${label}</div><div class=\"view-value\">${valueHtml ?? '<span class=\"empty\">-</span>'}</div></div>`;
    }

    function renderUserLink(name, id) {
        // Handle null, undefined, or empty string
        if (!name || (typeof name === 'string' && name.trim() === '')) {
            return '<span class="empty">-</span>';
        }
        // Ensure name is a string
        const nameStr = String(name).trim();
        if (nameStr === '') {
            return '<span class="empty">-</span>';
        }
        // Render as link if ID is provided
        if (id) {
            return `<a href="/view/people/${id}" class="user-link">${escapeHtml(nameStr)}</a>`;
        }
        // Otherwise just render as text
        return escapeHtml(nameStr);
    }

    // Helper function to find user by ID
    function findUserById(people, userId) {
        if (!people || !Array.isArray(people)) {
            console.log('findUserById: people data not available or not array');
            return null;
        }
        console.log(`findUserById: Looking for userId ${userId} in ${people.length} people`);
        const user = people.find(person => person.ID === userId || person.id === userId);
        console.log('findUserById: Found user:', user);
        return user;
    }

    // Helper function to find CIA rating by ID
    function findCiaRatingById(ciaRatings, ratingId) {
        if (!ciaRatings || !Array.isArray(ciaRatings)) return null;
        const normalized = String(ratingId ?? '').trim();
        if (!normalized) return null;
        return ciaRatings.find(rating => String(rating.id ?? rating.ID ?? '').trim() === normalized);
    }

    // Helper function to find KDE type by ID
    function findKdeTypeById(kdeTypes, kdeId) {
        if (!kdeTypes || !Array.isArray(kdeTypes)) return null;
        return kdeTypes.find(kde => kde.ID === kdeId || kde.id === kdeId);
    }

    // Helper function to format date
    function formatDate(dateString) {
        if (!dateString) return '';
        try {
            return new Date(dateString).toLocaleDateString('en-GB');
        } catch (error) {
            return dateString;
        }
    }

    let currentView = 'original'; // Track current view mode
    
    /**
     * Get the current view mode from the toggle state
     * MANDATORY: Always default to 'original' view on page load/refresh
     */
    function getCurrentViewMode() {
        const activeToggle = document.querySelector('.revision-toggle-link.active');
        if (activeToggle) {
            const toggleView = activeToggle.dataset.view;
            if (toggleView === 'original' || toggleView === 'changes') {
                currentView = toggleView; // Sync currentView with toggle
                return toggleView;
            }
        }
        
        // Always default to 'original' - clear any 'changes' from sessionStorage
        try {
            const id = parseId();
            if (id != null) {
                const key = `pendingChanges:view:Glossary#${id}`;
                if (typeof sessionStorage !== 'undefined') {
                    const saved = sessionStorage.getItem(key);
                    if (saved === 'changes') {
                        sessionStorage.removeItem(key);
                    }
                }
            }
        } catch (e) {
            // ignore storage errors
        }
        
        // Always default to 'original' - mandatory requirement
        currentView = 'original';
        return 'original';
    }
    
    async function load(id, view = null) {
        const container = document.getElementById('glossaryViewContainer');
        if (!container) {
            console.error('[Glossary] Container not found: glossaryViewContainer');
            return;
        }
        
        // Ensure container is visible before loading
        container.style.display = '';
        container.style.visibility = 'visible';
        
        const titleElement = document.getElementById('glossaryTitle');
        const breadcrumbElement = document.getElementById('glossaryBreadcrumb');
        
        // Update current view
        if (view !== null) {
            currentView = view;
        }
        
        container.innerHTML = '<div class="view-section" style="grid-column: 1/-1;">Loading...</div>';
        try {
            // Add view parameter to API call if viewing changes
            let g = await window.BUDG_API_SERVICE.getGlossaryById(id, view === 'changes' ? 'changes' : null);
            if (g && g.data) g = g.data;

            try {
                const isGuest = await isGuestVisitorForGlossary();
                const segmentName = g?.segmentName || g?.segment_name || g?.segment;
                const segmentId = g?.segmentId ?? g?.segment_id ?? g?.Segment_ID;
                const segmentNameLower = (segmentName || '').toString().toLowerCase();
                if (isGuest && segmentNameLower !== 'enterprise') {
                    console.log('[Glossary] Guest visitor blocked from non-Enterprise segment view', { glossaryId: id, segmentName, segmentId });
                    renderGlossaryGuestAccessDenied(container, id, segmentName, segmentId);
                    return;
                }
            } catch (gateError) {
                console.warn('[Glossary] Error during guest/segment access check, falling back to normal render:', gateError);
            }
            
            // Debug: Log the complete glossary data to console
            console.log('=== GLOSSARY DATA DEBUG ===');
            console.log('Complete glossary object:', g);
            console.log('All available keys:', Object.keys(g));
            // Check for exact database field names
            console.log('=== DATABASE FIELD CHECK ===');
            console.log('CreatedBy_ID:', g.CreatedBy_ID);
            console.log('Last_updated_userID:', g.Last_updated_userID);
            console.log('Created_Datetime:', g.Created_Datetime);
            console.log('Last_Updated_Datetime:', g.Last_Updated_Datetime);
            console.log('=== USER FIELDS CHECK ===');
            console.log('createdByName:', g.createdByName);
            console.log('createdById:', g.createdById);
            console.log('updatedByName:', g.updatedByName);
            console.log('updatedById:', g.updatedById);
            console.log('created:', g.created);
