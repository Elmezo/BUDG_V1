            console.log('================');
            
            // Compute user display values before template creation
            let createdByDisplay = '<span class="empty">-</span>';
            let lastUpdatedByDisplay = '<span class="empty">-</span>';
            let lastUpdatedDateDisplay = '<span class="empty">-</span>';
            
            // Created By
            const createdByName = g.createdByName || g.CreatedByName;
            const createdById = g.CreatedBy_ID || g.createdById;
            if (createdByName && String(createdByName).trim() !== '') {
                createdByDisplay = renderUserLink(String(createdByName).trim(), createdById);
            } else if (createdById && lookupData && lookupData.people) {
                const user = findUserById(lookupData.people, createdById);
                if (user) {
                    const fullName = `${user.First_Name || ''} ${user.Last_Name || ''}`.trim();
                    if (fullName) {
                        createdByDisplay = renderUserLink(fullName, createdById);
                    }
                }
            } else if (createdById) {
                createdByDisplay = renderUserLink('Unknown User', createdById);
            }
            
            // Last Updated By (fall back to Created By when never updated)
            const lastUpdatedUserId = g.Last_updated_userID || g.updatedById;
            const lastUpdatedUserIdForDisplay = lastUpdatedUserId || createdById;
            if (lastUpdatedUserIdForDisplay) {
                const lastUpdatedUserName = (lastUpdatedUserId ? (g.updatedByName || g.UpdatedByName) : null) || createdByName;
                if (lastUpdatedUserName && String(lastUpdatedUserName).trim() !== '') {
                    lastUpdatedByDisplay = renderUserLink(String(lastUpdatedUserName).trim(), lastUpdatedUserIdForDisplay);
                } else if (lookupData && lookupData.people) {
                    const user = findUserById(lookupData.people, lastUpdatedUserIdForDisplay);
                    if (user) {
                        const fullName = `${user.First_Name || ''} ${user.Last_Name || ''}`.trim();
                        if (fullName) {
                            lastUpdatedByDisplay = renderUserLink(fullName, lastUpdatedUserIdForDisplay);
                        }
                    }
                } else {
                    lastUpdatedByDisplay = renderUserLink('Unknown User', lastUpdatedUserIdForDisplay);
                }
            }
            
            // Last Updated Date (fall back to Created Date when never updated)
            const lastUpdatedDate = g.lastUpdated || g.Last_Updated_Datetime || g.last_Updated_Datetime || g.lastUpdatedDatetime;
            const createdDate = g.created || g.Created_Datetime || g.created_Datetime || g.createdDatetime;
            if (lastUpdatedDate) {
                lastUpdatedDateDisplay = new Date(lastUpdatedDate).toLocaleString();
            } else if (createdDate) {
                lastUpdatedDateDisplay = new Date(createdDate).toLocaleString();
            }
            
            console.log('[Pre-computed] createdByDisplay:', createdByDisplay);
            console.log('[Pre-computed] lastUpdatedByDisplay:', lastUpdatedByDisplay);
            console.log('[Pre-computed] lastUpdatedDateDisplay:', lastUpdatedDateDisplay);
            console.log('[Pre-computed] createdByName from g:', g.createdByName);
            console.log('[Pre-computed] createdById from g:', g.CreatedBy_ID, g.createdById);
            
            const gT = (k) => (window.I18n && window.I18n.t(k)) || k;
            // Now define classifications section with lookup data available
            const classificationsSection = `
                <div class="view-section sidebar-section" >
                    <div class="section-title">${gT('glossary.sections.classifications')}</div>
                    
                    <div class="classifications-group">
                        <div class="group-title">${gT('glossary.sections.basicClassifications')}</div>
                        <div class="classification-item">
                            <span class="classification-label">${gT('glossary.labels.budgStatus')}:</span>
                            <span class="classification-value">
                                <span class="status-dot ${g.statusName ? 'active' : ''}"></span>
                                ${escapeHtml(g.statusName || '')}
                            </span>
                        </div>
                        <div class="classification-item">
                            <span class="classification-label">${gT('glossary.labels.lifecycle')}:</span>
                            <span class="classification-value">
                                <span class="lifecycle-badge">${escapeHtml(g.lifecycleName || '')}</span>
                            </span>
                        </div>
                        <div class="classification-item">
                            <span class="classification-label">${gT('glossary.labels.budgViewing')}:</span>
                            <span class="classification-value">${escapeHtml(g.viewingName || '')}</span>
                        </div>
                    </div>

                    <div class="classifications-group">
                        <div class="group-title">${gT('glossary.sections.otherInformation')}</div>
                        <div class="classification-item">
                            <span class="classification-label">${gT('glossary.labels.securityClassification')}:</span>
                            <span class="classification-value">${escapeHtml(g.securityName || '')}</span>
                        </div>
                        <div class="classification-item">
                            <span class="classification-label">${gT('glossary.labels.type')}:</span>
                            <span class="classification-value">
                                <span class="type-badge ${(g.typeName || '').toLowerCase()}">${escapeHtml(g.typeName || '')}</span>
                            </span>
                        </div>
                        <div class="classification-item">
                            <span class="classification-label">${gT('glossary.labels.createdBy')}:</span>
                            <span class="classification-value">${createdByDisplay}</span>
                        </div>
                        <div class="classification-item">
                            <span class="classification-label">${gT('glossary.labels.created')}:</span>
                            <span class="classification-value">${(() => {
                                const createdDate = g.created || g.Created_Datetime || g.created_Datetime || g.createdDatetime;
                                return createdDate ? new Date(createdDate).toLocaleString() : '<span class="empty">-</span>';
                            })()}</span>
                        </div>
                        <div class="classification-item">
                            <span class="classification-label">${gT('glossary.labels.lastUpdatedBy')}:</span>
                            <span class="classification-value">${lastUpdatedByDisplay}</span>
                        </div>
                        <div class="classification-item">
                            <span class="classification-label">${gT('glossary.labels.lastUpdated')}:</span>
                            <span class="classification-value">${lastUpdatedDateDisplay}</span>
                        </div>
                        <div class="classification-item">
                            <span class="classification-label">${gT('glossary.labels.lastApprovedDate')}:</span>
                            <span class="classification-value">${gT('glossary.values.notAvailable')}</span>
                        </div>
                        <div class="classification-item">
                            <span class="classification-label">${gT('glossary.labels.nextReviewDate')}:</span>
                            <span class="classification-value">${gT('glossary.values.notEnforced')}</span>
                        </div>
                        <div class="classification-item">
                            <span class="classification-label">${gT('glossary.labels.ciaRating')}:</span>
                            <span class="classification-value">${(() => {
                                // Use the explicit *_Rating fields from backend and show "-" for empty values.
                                const confRating = g.Confidentiality_Rating ?? g.confidentiality_Rating;
                                const intRating = g.Integrity_Rating ?? g.integrity_Rating;
                                const availRating = g.Availability_Rating ?? g.availability_Rating;

                                const toDisplay = (id, ratings) => {
                                    const normalized = String(id ?? '').trim();
                                    if (!normalized) return '-';
                                    const r = ratings && findCiaRatingById(ratings, normalized);
                                    if (!r) return '-';
                                    return String(r.Values ?? r.values ?? '-');
                                };

                                const confVal = toDisplay(confRating, lookupData.ciaRatings);
                                const intVal = toDisplay(intRating, lookupData.ciaRatings);
                                const availVal = toDisplay(availRating, lookupData.ciaRatings);

                                return `<div class="cia-inline">
                                    <div class="cia-item"><span class="view-badge">C</span> ${escapeHtml(confVal)}</div>
                                    <div class="cia-item"><span class="view-badge">I</span> ${escapeHtml(intVal)}</div>
                                    <div class="cia-item"><span class="view-badge">A</span> ${escapeHtml(availVal)}</div>
                                </div>`;
                            })()}</span>
                        </div>
                        <div class="classification-item">
                            <span class="classification-label">${gT('glossary.labels.kde')}:</span>
                            <span class="classification-value">${escapeHtml(
                                (() => {
                                    // Try multiple field name variations for KDE
                                    const kdeId = g.KDE || g.kde || g.kdeType || g.KDEType;
                                    
                                    if (kdeId && lookupData.kdeTypes) {
                                        const kdeType = findKdeTypeById(lookupData.kdeTypes, kdeId);
                                        return kdeType ? (kdeType.Name || kdeType.name) : '-';
                                    }
                                    return '-';
                                })()
                            )}</span>
                        </div>
                        <div class="classification-item">
                            <span class="classification-label">${gT('glossary.labels.segment')}:</span>
                            <span class="classification-value">${escapeHtml(g.segmentName || g.segment_name || g.segment || ((g.segmentId ?? g.segment_id ?? g.Segment_ID) != null ? `ID ${g.segmentId ?? g.segment_id ?? g.Segment_ID}` : (window.I18n?.t('message.notSpecified') || 'Not specified')))}</span>
                        </div>
                    </div>

                    <div class="data-domain-rules">
                        <div class="rules-title">${gT('glossary.dataDomainRules.title')}</div>
                        <div class="rules-text">${gT('glossary.dataDomainRules.text')}</div>
                    </div>
                </div>
            `;
            
            // Update header with glossary data IMMEDIATELY after loading data
            if (titleElement) {
                if (g && g.name) {
                    titleElement.textContent = escapeHtml(g.name);
                    console.log('[Glossary] Title updated to:', g.name);
                } else {
                    console.warn('[Glossary] Glossary name not found in data:', g);
                }
            } else {
                console.warn('[Glossary] Title element not found (glossaryTitle)');
            }
            if (breadcrumbElement) {
                breadcrumbElement.innerHTML = (window.I18n && window.I18n.t('glossary.breadcrumb')) || 'glossary';
            }
            
            // Check if object is under revision and add toggle AFTER updating title
            if (window.PendingChanges && window.PendingChanges.initToggle) {
                try {
                    await window.PendingChanges.initToggle('Glossary', id, '.page-title-text', null);
                    
                    // Re-update title after toggle init to ensure it's still correct
                    if (titleElement && g && g.name) {
                        titleElement.textContent = escapeHtml(g.name);
                    }
                    // After toggle is initialized, check the toggle state and sync currentView
                    const activeToggle = document.querySelector('.revision-toggle-link.active');
                    if (activeToggle) {
                        const toggleView = activeToggle.dataset.view;
                        if (toggleView === 'original' || toggleView === 'changes') {
                            currentView = toggleView;
                            // If toggle is set to changes, reload data with changes view
                            if (toggleView === 'changes') {
                                const reloadData = await window.BUDG_API_SERVICE.getGlossaryById(id, 'changes');
                                g = reloadData;
                                // Re-render the page with the updated data
                                // We'll continue with the rendering below using the updated 'g' object
                            }
                        }
                    }
                } catch (error) {
                    console.error('Error initializing pending changes toggle:', error);
                }
            }
            
            // Re-compute user display values in case g object was updated (e.g., from changes view)
            // Created By
            const createdByName2 = g.createdByName || g.CreatedByName;
            const createdById2 = g.CreatedBy_ID || g.createdById;
            if (createdByName2 && String(createdByName2).trim() !== '') {
                createdByDisplay = renderUserLink(String(createdByName2).trim(), createdById2);
            } else if (createdById2 && lookupData && lookupData.people) {
                const user = findUserById(lookupData.people, createdById2);
                if (user) {
                    const fullName = `${user.First_Name || ''} ${user.Last_Name || ''}`.trim();
                    if (fullName) {
                        createdByDisplay = renderUserLink(fullName, createdById2);
                    }
                }
            } else if (createdById2) {
                createdByDisplay = renderUserLink('Unknown User', createdById2);
            } else {
                createdByDisplay = '<span class="empty">-</span>';
            }
            
            // Last Updated By (fall back to Created By when never updated)
            const lastUpdatedUserId2 = g.Last_updated_userID || g.updatedById;
            const lastUpdatedUserIdForDisplay2 = lastUpdatedUserId2 || createdById2;
            if (lastUpdatedUserIdForDisplay2) {
                const lastUpdatedUserName2 = (lastUpdatedUserId2 ? (g.updatedByName || g.UpdatedByName) : null) || createdByName2;
                if (lastUpdatedUserName2 && String(lastUpdatedUserName2).trim() !== '') {
                    lastUpdatedByDisplay = renderUserLink(String(lastUpdatedUserName2).trim(), lastUpdatedUserIdForDisplay2);
                } else if (lookupData && lookupData.people) {
                    const user = findUserById(lookupData.people, lastUpdatedUserIdForDisplay2);
                    if (user) {
                        const fullName = `${user.First_Name || ''} ${user.Last_Name || ''}`.trim();
                        if (fullName) {
                            lastUpdatedByDisplay = renderUserLink(fullName, lastUpdatedUserIdForDisplay2);
                        }
                    }
                } else {
                    lastUpdatedByDisplay = renderUserLink('Unknown User', lastUpdatedUserIdForDisplay2);
                }
            } else {
                lastUpdatedByDisplay = '<span class="empty">-</span>';
            }
            
            // Last Updated Date (fall back to Created Date when never updated)
            const lastUpdatedDate2 = g.lastUpdated || g.Last_Updated_Datetime || g.last_Updated_Datetime || g.lastUpdatedDatetime;
            const createdDate2 = g.created || g.Created_Datetime || g.created_Datetime || g.createdDatetime;
            if (lastUpdatedDate2) {
                lastUpdatedDateDisplay = new Date(lastUpdatedDate2).toLocaleString();
            } else if (createdDate2) {
                lastUpdatedDateDisplay = new Date(createdDate2).toLocaleString();
            } else {
                lastUpdatedDateDisplay = '<span class="empty">-</span>';
            }
            
            console.log('[Re-computed after potential g update] createdByDisplay:', createdByDisplay);
            
            const glossaryDescription = g.description || g.Description || '';
            const definitionSection = `
                <div class="view-section">
                    <div class="section-title">${gT('glossary.sections.definition')}</div>
                    <div class="glossary-view-description">${_richHtml(glossaryDescription)}</div>
                    ${renderItem(gT('glossary.labels.name'), escapeHtml(g.name || g.Name || ''))}
                    ${renderItem(gT('glossary.labels.ref') + ':', escapeHtml(g.ref || g.Ref_Number || ''))}
                    ${renderItem(gT('glossary.labels.aliasNames') + ':', g.aliases && g.aliases.length > 0 ? 
                        g.aliases.map(alias => escapeHtml(alias)).join(', ') : 
                        '<span class="empty">' + (window.I18n?.t('message.notSpecified') || 'Not specified') + '</span>')}
                    ${renderItem(gT('glossary.labels.formatType') + ':', escapeHtml(g.formatTypeName || g.format_type_name || ''))}
                    ${renderItem(gT('glossary.labels.formatDescription') + ':', g.format ? 
                        escapeHtml(g.format) : 
                        '<span class="empty">' + (window.I18n?.t('message.notSpecified') || 'Not specified') + '</span>')}
                    ${renderItem(gT('glossary.labels.ldmReference') + ':', g.ldm ? 
                        escapeHtml(g.ldm) : 
                        '<span class="empty">' + (window.I18n?.t('message.notSpecified') || 'Not specified') + '</span>')}
                    ${renderItem(gT('glossary.labels.businessLogic') + ':', (g.businessLogic ?? g.Business_Logic ?? g.business_logic) ? 
                        _richHtml(g.businessLogic ?? g.Business_Logic ?? g.business_logic) : 
                        '<span class="empty">' + (window.I18n?.t('message.notSpecified') || 'Not specified') + '</span>')}
                    ${renderItem(gT('glossary.labels.examples') + ':', (g.examples ?? g.Examples) ? 
                        _richHtml(g.examples ?? g.Examples) : 
                        '<span class="empty">' + (window.I18n?.t('message.notSpecified') || 'Not specified') + '</span>')}
                </div>
            `;

            // Load strategic source data - matches impact isolation mechanism
            let strategicSourceData = [];
            try {
                // Pass view parameter to filter pending changes in View Original mode
                // When view is 'original' or null, we pass null to get only original sources (backend filters out pending)
                // When view is 'changes', we pass 'changes' to get both original and pending sources
                // This matches the impact mechanism: view=changes shows pending, otherwise shows only original
                const viewParam = (view === 'changes') ? 'changes' : null;
                console.log('[Glossary View] Loading strategic sources with view:', viewParam, '(raw view:', view, ') for glossary:', id);
                strategicSourceData = await window.BUDG_API_SERVICE.getGlossaryStrategicSource(id, viewParam);
                console.log('[Glossary View] Strategic sources loaded:', strategicSourceData?.length || 0, 'sources', strategicSourceData);
            } catch (error) {
                console.error('[Glossary View] Error loading strategic sources:', error);
                strategicSourceData = []; // Fallback to empty array on error
            }
                const strategicSourceSection = `
                    <div class="view-section">
                        <div class="section-title" style="display: flex; align-items: center; justify-content: space-between;">
                            <span>STRATEGIC SOURCE</span>
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                <i class="fas fa-cog" style="color: var(--text-secondary, #6c757d); cursor: pointer;"></i>
                                <i class="fas fa-chevron-down" style="color: var(--text-secondary, #6c757d); cursor: pointer;"></i>
                            </div>
                        </div>
                        <div class="data-table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th><div class="th-content"><span>Relationship Type</span></div></th>
                                        <th><div class="th-content"><span>System</span></div></th>
                                        <th><div class="th-content"><span>Data Set</span></div></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${strategicSourceData && strategicSourceData.length > 0 ? 
                                        strategicSourceData.map(item => `
                                            <tr>
                                                <td>${escapeHtml(item.relationTypeName || item.relationshipType || 'Strategic Master Source for')}</td>
                                                <td><i class="fas fa-layer-group"></i> ${escapeHtml(item.systemName || '')}</td>
                                                <td><i class="fas fa-database"></i> ${item.datasetName ? escapeHtml(item.datasetName) : '<span style="color: var(--text-tertiary, #adb5bd); font-style: italic;">No dataset selected</span>'}</td>
                                            </tr>
                                        `).join('') :
                                        '<tr><td colspan="3" style="color: var(--text-tertiary, #adb5bd); padding: 1rem; text-align: center;">No strategic source data found</td></tr>'
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div style="text-align: right; color: var(--text-tertiary, #adb5bd); font-size: 0.8rem; margin-top: 0.5rem;">
                            ${strategicSourceData ? strategicSourceData.length : 0} record${strategicSourceData && strategicSourceData.length !== 1 ? 's' : ''}
                        </div>
                    </div>
                `;

                // Documents section - will be added after container.innerHTML
                const documentsSection = '';

                container.innerHTML = `
                    <div class="glossary-container">
                        <div class="left-column">
                        ${definitionSection}
                        ${strategicSourceSection}
                        ${documentsSection}
                        </div>
                        <div class="right-column">
                        ${classificationsSection}
                        </div>
                    </div>
                `;
                
                // Ensure container is visible after loading data - use requestAnimationFrame for better rendering
                if (container) {
                    // Use requestAnimationFrame to ensure DOM is ready
                    requestAnimationFrame(() => {
                        container.style.display = '';
                        container.style.visibility = 'visible';
                        container.style.opacity = '1';
                        console.log('[Glossary] Container displayed after loading data');
                        
                        // Force a reflow to ensure rendering
                        void container.offsetHeight;
                    });
                }
                
                // Render custom fields section
                if (window.CustomFields) {
                    try {
                        await window.CustomFields.renderViewSection({
                            facetId: 'Glossary',
                            containerId: 'glossaryViewContainer',
                            objectId: id,
                            title: 'CUSTOM FIELDS'
                        });
                    } catch (error) {
                        console.error('Error rendering custom fields:', error);
                    }
                }

                // Add DOCUMENTS collapsible section
                const noDocsText = window.I18n?.t('message.noDocuments') || 'No documents';
                const docsEmpty = '<div class="empty">' + noDocsText + '.</div>';
                const documentsTitle = window.I18n?.t('card.documents') || 'DOCUMENTS';
                const documentsCollapsibleSection = `
                    <div class="view-section" style="grid-column: 1/-1; margin-top: 2rem;" data-collapsible>
                        <div class="collapsible-header" style="display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.5rem; background: var(--background-secondary, #f8f9fa); border: 1px solid var(--border-color, #e5e7eb); border-radius: 8px; cursor: pointer;">
                            <div style="display: flex; align-items: center; gap: 0.75rem;">
                                <i class="fa-solid fa-file-lines" style="color: var(--secondary-color, #248567);"></i>
                                <h3 style="margin: 0; font-size: 0.875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">${documentsTitle}</h3>
                            </div>
                            <i class="fas fa-chevron-down" style="transition: transform 0.2s;"></i>
                        </div>
                        <div class="collapsible-body" style="display: none; padding: 1.5rem; border: 1px solid var(--border-color, #e5e7eb); border-top: none; border-radius: 0 0 8px 8px;">
                            ${docsEmpty}
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', documentsCollapsibleSection);

                // Wire up collapsible toggle
                const documentsCollapsible = container.querySelector('[data-collapsible]');
                if (documentsCollapsible) {
                    const header = documentsCollapsible.querySelector('.collapsible-header');
                    const body = documentsCollapsible.querySelector('.collapsible-body');
                    if (header && body) {
                        header.addEventListener('click', function() {
                            const isOpen = documentsCollapsible.classList.contains('open');
                            documentsCollapsible.classList.toggle('open');
                            header.setAttribute('aria-expanded', String(!isOpen));
                            body.style.display = isOpen ? 'none' : 'block';
                            const chevron = header.querySelector('.fa-chevron-down');
                            if (chevron) {
                                chevron.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
                            }
                        });
                    }
                }

                // Load Documents (pass view mode to exclude pending documents in original view)
                loadDocuments(id, view);
        } catch (e) {
            console.error('Error loading glossary:', e);
            const isForbidden = e?.status === 403 || String(e?.message || '').includes('403');
            if (isForbidden) {
                container.innerHTML = `
                    <div class="view-section" style="color: var(--danger, #b91c1c); text-align: center; padding: 2rem;">
                        <h3>Glossary Not Available</h3>
                        <p>This object is not available.</p>
                        <button class="btn btn-primary" onclick="window.location.href='/view/glossary/glossary.html'">
                            Back to Glossary List
                        </button>
                    </div>
                `;
            } else if (e.status === 404) {
                container.innerHTML = `
                    <div class="view-section" style="color: var(--danger, #b91c1c); text-align: center; padding: 2rem;">
                        <h3>Glossary Not Found</h3>
                        <p>The glossary with ID ${id} does not exist or has been deleted.</p>
                        <button class="btn btn-primary" onclick="window.location.href='/view/glossary/glossary.html'">
                            Back to Glossary List
                        </button>
                    </div>
                `;
            } else {
                container.innerHTML = `
                    <div class="view-section" style="color: var(--danger, #b91c1c); text-align: center; padding: 2rem;">
                        <h3>Error Loading Glossary</h3>
                        <p>Failed to load glossary (id=${id}). ${e.message || 'Unknown error occurred.'}</p>
                        <button class="btn btn-primary" onclick="window.location.href='/view/glossary/glossary.html'">
                            Back to Glossary List
                        </button>
                    </div>
                `;
            }
        }
    }

    // Store document table instance for view mode switching
    let glossaryDocumentTable = null;
    
    async function loadDocuments(glossaryId, viewMode = null) {
        // Find the documents collapsible section within the glossary view container
        const container = document.getElementById('glossaryViewContainer');
        if (!container) {
            console.warn('Glossary view container not found');
            return;
        }
        const documentsSection = container.querySelector('[data-collapsible] .collapsible-body');
        if (!documentsSection) {
            console.warn('Documents section not found');
            return;
        }

        // Create container for document table
        const containerId = 'glossaryDocumentsTableContainer';
        documentsSection.innerHTML = `<div id="${containerId}"></div>`;

        // Initialize document table component (read-only for view page)
        if (typeof DocumentTableComponent !== 'undefined') {
            try {
                glossaryDocumentTable = new DocumentTableComponent({
                    facetType: 'glossary',
                    facetId: glossaryId,
                    container: `#${containerId}`,
                    canEdit: false, // Read-only in view mode
                    viewMode: viewMode // Pass view mode to filter pending documents
                });
            } catch (error) {
                console.error('Error initializing document table:', error);
                const failedToLoadDocs = window.I18n?.t('message.failedToLoadDocuments') || 'Failed to load documents.';
                documentsSection.innerHTML = '<div class="empty" style="color:var(--danger,#b91c1c);">' + failedToLoadDocs + '</div>';
            }
        } else {
            console.error('DocumentTableComponent not found');
            const docComponentNotAvailable = window.I18n?.t('message.documentComponentNotAvailable') || 'Document component not available.';
            documentsSection.innerHTML = '<div class="empty">' + docComponentNotAvailable + '</div>';
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        hideEditsIfUnauthenticated();
        console.log('Glossary page loaded');
        const backBtn = document.getElementById('backBtn');
        
        console.log('Back button found:', backBtn);
        
        if (backBtn) backBtn.addEventListener('click', () => window.history.length > 1 ? window.history.back() : window.location.assign('/'));
        
        const id = parseId();
        if (id != null) {
            // Ensure content body and container are visible
            const contentBody = document.querySelector('.content-body');
            if (contentBody) {
                contentBody.style.display = '';
            }
            const glossaryViewContainer = document.getElementById('glossaryViewContainer');
            if (glossaryViewContainer) {
                glossaryViewContainer.style.display = '';
                glossaryViewContainer.style.visibility = 'visible';
            }
            
            // Load with null view first, then toggle will set the correct view
            // The toggle initialization in load() will sync currentView
            load(id, null).then(async function(){
                // Force a re-render to ensure data is visible
                const container = document.getElementById('glossaryViewContainer');
                if (container) {
                    container.style.display = '';
                    container.style.visibility = 'visible';
                    
                    // Ensure summary tab is active and content is visible
                    const summaryTab = document.querySelector('.tab[data-tab="summary"]');
                    if (summaryTab) {
                        summaryTab.classList.add('active');
                        // Remove active from other tabs
                        document.querySelectorAll('.tab-container .tab').forEach(t => {
                            if (t !== summaryTab) {
                                t.classList.remove('active');
                            }
                        });
                    }
                    
                    // Trigger a small delay to ensure DOM is updated
                    await new Promise(resolve => setTimeout(resolve, 50));
                }
                
                // Check and display lock status
                if (window.ViewLockHelper) {
                    await window.ViewLockHelper.checkAndDisplayLockStatus('glossary', id);
                }
                
            if (window.addFollowButton) {
                try {
                    await window.addFollowButton('glossary', id, null, '.form-actions');
                } catch (e) {
                    console.error('Failed to initialize follow button for glossary:', e);
                }
            }
        });
        try { window.BUDG_API_SERVICE.logVisit({ entity: 'CatItemCategory', entityId: String(id), route: `/view/glossary/${id}` }); } catch(_) {}
                }

    });

    // Get glossary relationships map HTML using shared generator
    function getGlossaryRelationshipsMapHtml() {
        if (window.SharedMapHTML) {
            return window.SharedMapHTML({
                mapId: 'glossaryRelationshipsMap',
                defaultMapType: 'glossary-lineage',
                mapTypeOptions: [
                    { value: 'glossary-lineage', label: 'Glossary Lineage' },
                    { value: 'dataset-lineage', label: 'Dataset Lineage' },
                    { value: 'system-lineage', label: 'System Lineage' }
                ],
                overlayConfig: {
                    glossaryLineage: {
                        columns: [
                            {
                                header: 'Data',
                                items: [
                                    { overlay: 'description', icon: 'fa-info-circle', label: 'Description' },
                                    { overlay: 'stakeholders', icon: 'fa-users', label: 'Stakeholders' }
                                ]
                            }
                        ]
                    },
                    systemLineage: {
                        columns: [
                            {
                                header: 'Data',
                                items: [
                                    { overlay: 'description', icon: 'fa-info-circle', label: 'Description' },
                                    { overlay: 'glossary', icon: 'fa-book', label: 'Glossary' },
                                    { overlay: 'datasets', icon: 'fa-layer-group', label: 'Data Sets' },
                                    { overlay: 'attributes', icon: 'fa-th', label: 'Attributes' }
                                ]
                            }
                        ]
                    },
                    datasetLineage: {
                        columns: [
                            {
                                header: 'Data',
                                items: [
                                    { overlay: 'description', icon: 'fa-info-circle', label: 'Description' },
                                    { overlay: 'glossary', icon: 'fa-book', label: 'Glossary' },
                                    { overlay: 'attributes', icon: 'fa-th', label: 'Attributes' }
                                ]
                            }
                        ]
                    }
                },
                filterConfig: {
                    glossaryLineage: {
                        categories: [
                            {
                                header: 'RELATIONSHIP TYPE',
                                dynamic: true,
                                containerId: 'glossaryRelationshipsMapFilterRelationTypeOptions'
                            }
                        ]
                    },
                    systemLineage: {
                        categories: [
                            {
                                header: 'TYPE',
                                dynamic: true,
                                containerId: 'glossaryRelationshipsMapSystemFilterTypeOptions'
                            },
                            {
                                header: 'LIFECYCLE',
                                dynamic: true,
                                containerId: 'glossaryRelationshipsMapSystemFilterLifecycleOptions'
                            }
                        ]
                    },
                    datasetLineage: {
                        categories: [
                            {
                                header: 'TYPE',
                                dynamic: true,
                                containerId: 'glossaryRelationshipsMapDatasetFilterTypeOptions'
                            },
                            {
                                header: 'LIFECYCLE',
                                dynamic: true,
                                containerId: 'glossaryRelationshipsMapDatasetFilterLifecycleOptions'
                            }
                        ]
                    }
                }
            });
        }
        
        // Fallback to basic HTML if shared generator not available
        return `
            <div class="map-section" id="glossaryRelationshipsMapSection" style="grid-column:1/-1; margin-bottom: 1.5rem;">
                <div class="map-section-header">
                    <div class="map-section-title">MAP</div>
                    <button type="button" class="map-collapse-btn" id="glossaryRelationshipsMapCollapseBtn" title="Collapse/Expand">
                        <i class="fas fa-minus"></i>
                    </button>
                </div>
                <div class="interface-map-toolbar">
                    <div class="map-control-group">
                        <label>Map type:</label>
                        <select id="glossaryRelationshipsMapTypeSelect" class="map-select">
                            <option value="glossary-lineage" selected>Glossary Lineage</option>
                            <option value="dataset-lineage">Dataset Lineage</option>
                            <option value="system-lineage">System Lineage</option>
                        </select>
                    </div>
                </div>
                <div class="interface-map-body">
                    <div class="interface-map-canvas" id="glossaryRelationshipsMapCanvas">
                        <div class="interface-map-loading" data-map-loading style="display:none;">
                            <i class="fas fa-spinner fa-spin"></i>
                            <span>Building lineage map...</span>
                        </div>
                    </div>
                </div>
            </div>
        `;
    }

    // Function to load relationships data
    async function loadRelationshipsData(glossaryId, view = null) {
        const tbody = document.getElementById('relationshipsTableBody');
        const footer = document.querySelector('#relationshipsContent .hierarchy-footer');

        if (!tbody) return;

        // Determine view parameter - matches strategic source and impact isolation mechanism
        const viewParam = (view === 'changes') ? 'changes' : null;
        console.log('[Glossary Relationships] Loading bidirectional relationships for glossary ID:', glossaryId, 'with view:', viewParam);

        try {
            // Show loading state
            tbody.innerHTML = '<tr><td colspan="3" style="text-align:center;padding:2rem;color:var(--text-muted,#6b7280);">Loading...</td></tr>';

            // Fetch bidirectional relationships (both as source and target)
            // Pass view parameter to filter pending changes in View Original mode
            console.log('[Glossary Relationships] Calling API: getGlossaryBidirectionalRelationships(' + glossaryId + ', ' + viewParam + ')');
            const relationships = await window.BUDG_API_SERVICE.getGlossaryBidirectionalRelationships(glossaryId, viewParam);
            console.log('[Glossary Relationships] API Response:', relationships);

            if (!Array.isArray(relationships) || relationships.length === 0) {
                tbody.innerHTML = '<tr><td colspan="3" style="text-align:center;padding:2rem;color:var(--text-muted,#9ca3af);">No relationships found</td></tr>';
                const footerEl = document.getElementById('relationshipsFooter');
                if (footerEl) footerEl.textContent = '0 records';
                return;
            }

            // Update footer
            const footerEl = document.getElementById('relationshipsFooter');
            if (footerEl) footerEl.textContent = `${relationships.length} record${relationships.length !== 1 ? 's' : ''}`;

            // Render relationships table with bidirectional support
            tbody.innerHTML = relationships.map(function(rel) {
                // Use relatedGlossaryId and relatedGlossaryName for both directions
                const relatedGlossaryId = rel.relatedGlossaryId;
                const relatedGlossaryName = rel.relatedGlossaryName || 'Unknown';
                const relatedGlossaryType = rel.relatedGlossaryType || 'Unknown';
                const direction = rel.direction || 'outgoing'; // 'outgoing' or 'incoming'
                
                const glossaryLink = relatedGlossaryId 
                    ? `<a href="/view/glossary/${relatedGlossaryId}" class="glossary-link">${escapeHtml(relatedGlossaryName)}</a>`
                    : escapeHtml(relatedGlossaryName);
                
                // Add direction indicator to relationship type name
                const relationTypeDisplay = escapeHtml(rel.relationTypeName || 'Unknown');
                const directionBadge = direction === 'incoming' 
                    ? '<span style="font-size: 0.75rem; color: #6b7280; margin-left: 0.25rem;">(incoming)</span>'
                    : '<span style="font-size: 0.75rem; color: #6b7280; margin-left: 0.25rem;">(outgoing)</span>';
                
                return `
                    <tr>
                        <td style="text-align: center;">
                            <span class="view-badge">${relationTypeDisplay}${directionBadge}</span>
                        </td>
                        <td style="text-align: center;">
                            <div class="glossary-item">
                                <i class="fas fa-book database-icon"></i>
                                ${glossaryLink}
                                </div>
                        </td>
                        <td style="text-align: center;">
                            <span class="view-badge">${escapeHtml(relatedGlossaryType)}</span>
                        </td>
                    </tr>
                `;
            }).join('');

            if (footer) {
                footer.textContent = `${relationships.length} record${relationships.length !== 1 ? 's' : ''}`;
            }

        } catch (error) {
            console.error('Failed to load relationships:', error);
            console.error('Error details:', {
                message: error.message,
                status: error.status,
                body: error.body
            });
            tbody.innerHTML = '<tr><td colspan="3" style="text-align:center;padding:2rem;color:var(--danger,#b91c1c);">Failed to load relationships: ' + error.message + '</td></tr>';
            if (footer) footer.textContent = '0 records';
        }
    }

    // Function to view glossary details
    function viewGlossary(glossaryId) {
        window.location.href = `/view/glossary/${glossaryId}`;
    }

    // Setup add relationship functionality
    function setupAddRelationship(glossaryId) {
        const addBtn = document.getElementById('addRelationshipBtn');
        const modal = document.getElementById('addRelationshipModal');
        const cancelBtn = document.getElementById('cancelRelationshipBtn');
        const form = document.getElementById('addRelationshipForm');
        const relationshipTypeSelect = document.getElementById('relationshipTypeSelect');
        const targetGlossarySelect = document.getElementById('targetGlossarySelect');

        if (!addBtn || !modal || !form) return;

        // Load relationship types and glossaries
        async function loadRelationshipTypes() {
            try {
                const types = await window.BUDG_API_SERVICE.getGlossaryRelationTypes();
                relationshipTypeSelect.innerHTML = '<option value="">Select Relationship Type</option>';
                const typesArray = Array.isArray(types) ? types : (types?.data || []);
                typesArray.forEach(type => {
                    const option = document.createElement('option');
                    option.value = type.id || type.ID;
                    option.textContent = type.name || type.Name || type.PrimaryName;
                    relationshipTypeSelect.appendChild(option);
                });
            } catch (error) {
                console.error('Failed to load relationship types:', error);
            }
        }

        async function loadGlossaries() {
            try {
                const glossaries = await window.BUDG_API_SERVICE.getGlossaryList();
                targetGlossarySelect.innerHTML = '<option value="">Select Glossary</option>';
                const glossaryArray = Array.isArray(glossaries) ? glossaries : (glossaries?.data || []);
                glossaryArray.forEach(glossary => {
                    // Don't allow selecting the current glossary
                    if (glossary.id === glossaryId || glossary.ID === glossaryId) return;
                    const option = document.createElement('option');
                    option.value = glossary.id || glossary.ID;
                    option.textContent = glossary.name || glossary.Name;
                    targetGlossarySelect.appendChild(option);
                });
            } catch (error) {
                console.error('Failed to load glossaries:', error);
            }
        }

        // Open modal
        addBtn.addEventListener('click', async function() {
            modal.style.display = 'flex';
            await loadRelationshipTypes();
            await loadGlossaries();
        });

        // Close modal
        cancelBtn?.addEventListener('click', function() {
            modal.style.display = 'none';
            form.reset();
        });

        // Close modal when clicking outside
        modal.addEventListener('click', function(e) {
            if (e.target === modal) {
                modal.style.display = 'none';
                form.reset();
            }
        });

        // Save relationship
        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const relationshipTypeId = relationshipTypeSelect.value;
            const targetGlossaryId = targetGlossarySelect.value;

            if (!relationshipTypeId || !targetGlossaryId) {
                alert('Please select both Relationship Type and Target Glossary');
                return;
            }

            try {
                const response = await window.BUDG_API_SERVICE.createGlossaryRelationship({
                    sourceGlossaryId: glossaryId,
                    targetGlossaryId: parseInt(targetGlossaryId),
                    relationType: parseInt(relationshipTypeId)
                });

                if (response && (response.success !== false)) {
                    // Reload relationships
                    await loadRelationshipsData(glossaryId);
                    // Close modal
                    modal.style.display = 'none';
                    form.reset();
                    // Show success message
                    console.log('Relationship added successfully');
                } else {
                    throw new Error(response?.error || 'Failed to add relationship');
                }
            } catch (error) {
                console.error('Failed to add relationship:', error);
                alert('Failed to add relationship: ' + (error.message || error));
            }
        });
    }

    // Data tab functions moved to glossary-data-tab.js isolated module

	    // Helper function to show placeholder content for tabs
    function showPlaceholderContent(container, tabName, iconClass) {
        const tabKey = 'tab.' + tabName.split('-').map((p, i) => i ? p.charAt(0).toUpperCase() + p.slice(1) : p).join('');
        const tabLabel = (window.I18n && window.I18n.t(tabKey)) || tabName.replace(/-/g, ' ').toUpperCase();
        const msg = (window.I18n && window.I18n.t('glossary.placeholder.tabContentSoon')) || '{tab} tab content will be available soon.';
        const text = msg.replace('{tab}', tabLabel);
        container.innerHTML = `
            <div class="view-section" style="grid-column: 1/-1; padding: 3rem; text-align: center;">
                <i class="${iconClass}" style="font-size: 3rem; color: var(--text-secondary, #64748b); margin-bottom: 1rem; display: block;"></i>
                <p style="font-size: 1.125rem; color: var(--text-primary, #1e293b); margin: 0;">
                    ${text}
                </p>
                        </div>
                    `;
    }

	    // Helper function to load glossary hierarchy data
    async function loadGlossaryHierarchy(glossaryId) {
                            const tbody = document.getElementById('hierarchyTbody');
                            const footer = document.getElementById('hierarchyFooter');
                            
                            if (!tbody || !footer) return;
                            
        const hierT = (k) => (window.I18n && window.I18n.t(k)) || k;
        try {
                            // Show loading state
            tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:2rem;color:var(--text-muted,#6b7280);">' + hierT('glossary.hierarchy.loadingHierarchy') + '</td></tr>';
            footer.textContent = hierT('glossary.hierarchy.loading');

            // Fetch hierarchy data from API (includes ancestors, current, siblings, children, and siblings' children)
            console.log('[Hierarchy] Fetching hierarchy for glossary ID:', glossaryId);
            const hierarchyData = await window.BUDG_API_SERVICE.getGlossaryHierarchy(glossaryId);
            console.log('[Hierarchy] Raw API response:', hierarchyData);
            console.log('[Hierarchy] Response type:', typeof hierarchyData);
            console.log('[Hierarchy] Is array?', Array.isArray(hierarchyData));
            
            // Handle different response formats
            let items = [];
            if (Array.isArray(hierarchyData)) {
                items = hierarchyData;
            } else if (hierarchyData && hierarchyData.data && Array.isArray(hierarchyData.data)) {
                items = hierarchyData.data;
            } else if (hierarchyData && Array.isArray(hierarchyData.items)) {
                items = hierarchyData.items;
            } else if (hierarchyData && typeof hierarchyData === 'object') {
                // Try to extract array from object
                const keys = Object.keys(hierarchyData);
                for (const key of keys) {
                    if (Array.isArray(hierarchyData[key])) {
                        items = hierarchyData[key];
                        break;
                    }
                }
            }
            
            console.log('[Hierarchy] Processed items:', items);
            console.log('[Hierarchy] Items count:', items.length);
            
            if (items.length === 0) {
                console.warn('[Hierarchy] No hierarchy data found for glossary ID:', glossaryId);
                tbody.innerHTML = '<tr><td colspan="8" style="color:var(--text-muted,#9ca3af);padding:1rem;text-align:center;">' + hierT('glossary.hierarchy.noData') + '</td></tr>';
                                footer.textContent = hierT('glossary.hierarchy.zeroRecords');
                                return;
                            }

            console.log('Glossary hierarchy data from API:', items);
            console.log('Current glossary ID:', glossaryId);
            
            // Build hierarchy tree structure from flat data with levels
            // Organize by relation type: ancestors (negative levels), current (level 0), siblings (level 0), descendants (positive levels), sibling_children (positive levels)
            const byId = new Map();
            const childrenMap = new Map();
            
            items.forEach(item => {
                const id = item.id;
                const parentId = item.parentId;
                byId.set(id, item);
                if (!childrenMap.has(parentId)) childrenMap.set(parentId, []);
                childrenMap.get(parentId).push(item);
            });
            
            // Find current glossary to determine its parent and calculate base depth
            const currentGlossary = items.find(item => item.relation === 'current');
            const currentParentId = currentGlossary ? currentGlossary.parentId : null;
            
            // Find the maximum ancestor level (most negative) to calculate base depth
            const ancestors = items.filter(item => item.relation === 'ancestor');
            const maxAncestorLevel = ancestors.length > 0 ? Math.min(...ancestors.map(a => a.level)) : 0;
            const ancestorDepthOffset = Math.abs(maxAncestorLevel); // How many ancestor levels we have
            
            // Calculate current depth: if has ancestors, depth = ancestorDepthOffset, else 0
            const currentDepth = currentParentId ? ancestorDepthOffset : 0;
            
            // Build tree structure: ancestors -> siblings -> current -> descendants -> siblings' children
            const hierarchyRows = [];
            
            // Helper to calculate depth based on level and relation
            function calculateDepth(item) {
                if (item.relation === 'ancestor') {
                    // Ancestors: convert negative level to positive depth (most negative = depth 0)
                    return ancestorDepthOffset + item.level; // -1 becomes (offset-1), -2 becomes (offset-2), etc.
                } else if (item.relation === 'current') {
                    return currentDepth;
                } else if (item.relation === 'sibling') {
                    return currentDepth; // Same depth as current
                } else if (item.relation === 'descendant') {
                    // Descendants: current depth + level (1, 2, 3...)
                    return currentDepth + item.level;
                } else if (item.relation === 'sibling_child') {
                    // Sibling children: sibling depth + level (1, 2, 3...)
                    return currentDepth + item.level;
                }
                return 0;
            }
            
            // Build proper hierarchical tree structure using parent-child relationships
            // This ensures children appear directly under their parents, not just sorted by level
            function buildHierarchicalOrder(items, currentGlossaryId) {
                const result = [];
                const processed = new Set();
                
                // Helper function to recursively add node and its children
                function addNodeAndChildren(nodeId, depth) {
                    if (processed.has(nodeId)) return;
                    processed.add(nodeId);
                    
                    const node = byId.get(nodeId);
                    if (!node) return;
                    
                    // Add current node
                    result.push({ node, depth, parentId: node.parentId });
                    
                    // Get and sort children by name
                    const children = (childrenMap.get(nodeId) || []).sort((a, b) => {
                        return (a.name || '').localeCompare(b.name || '');
                    });
                    
                    // Recursively add children
                    children.forEach(child => {
                        addNodeAndChildren(child.id, depth + 1);
                    });
                }
                
                // First, add ancestors in order (from root to current's parent)
                const ancestors = items.filter(item => item.relation === 'ancestor')
                    .sort((a, b) => a.level - b.level); // Most negative first (root ancestor)
                ancestors.forEach(ancestor => {
                    if (!processed.has(ancestor.id)) {
                        addNodeAndChildren(ancestor.id, calculateDepth(ancestor));
                    }
                });
                
                // Then add siblings (before current)
                const siblings = items.filter(item => item.relation === 'sibling')
                    .sort((a, b) => (a.name || '').localeCompare(b.name || ''));
                siblings.forEach(sibling => {
                    if (!processed.has(sibling.id)) {
                        addNodeAndChildren(sibling.id, calculateDepth(sibling));
                    }
                });
                
                // Then add current
                if (currentGlossary) {
                    addNodeAndChildren(currentGlossary.id, calculateDepth(currentGlossary));
                }
                
                // Then add descendants (children of current) - they will be added recursively
                const currentId = currentGlossary ? currentGlossary.id : currentGlossaryId;
                const descendants = items.filter(item => item.relation === 'descendant')
                    .filter(item => item.parentId === currentId); // Only direct children
                descendants.forEach(descendant => {
                    if (!processed.has(descendant.id)) {
                        addNodeAndChildren(descendant.id, calculateDepth(descendant));
                    }
                });
                
                // Finally, add sibling children (children of siblings) - they will be added recursively
                const siblingChildren = items.filter(item => item.relation === 'sibling_child');
                const siblingIds = siblings.map(s => s.id);
                siblingChildren
                    .filter(item => siblingIds.includes(item.parentId)) // Only direct children of siblings
                    .forEach(child => {
                        if (!processed.has(child.id)) {
                            addNodeAndChildren(child.id, calculateDepth(child));
                        }
                    });
                
                return result;
            }
            
            // Build hierarchy rows using proper tree structure
            const hierarchyRowsData = buildHierarchicalOrder(items, glossaryId);
            
            hierarchyRowsData.forEach(({ node, depth, parentId }) => {
                const children = childrenMap.get(node.id) || [];
                const hasChildren = children.length > 0;
                
                hierarchyRows.push({
                    node: node,
                    depth: depth,
                    parentId: parentId,
                    hasChildren: hasChildren,
                    relation: node.relation
                });
            });
            
            console.log('Processed hierarchy rows:', hierarchyRows);
            
            // Render the hierarchy
            const rowsHtml = hierarchyRows.map(({ node, depth, hasChildren, relation }) => {
                const name = node.name || '';
                const desc = node.description || '';
                const type = node.typeName || '';
                const isCurrent = relation === 'current';
                const id = node.id;
                const parentId = node.parentId || null;
                
                // Determine relationship type display (empty for current, show relationship for others)
                let relationshipDisplay = '';
                if (!isCurrent) {
                    if (relation === 'ancestor') {
                        relationshipDisplay = 'Is Parent Of';
                    } else if (relation === 'sibling') {
                        relationshipDisplay = 'Is Related to';
                    } else if (relation === 'descendant') {
                        relationshipDisplay = 'Is Child Of';
                    } else if (relation === 'sibling_child') {
                        relationshipDisplay = 'Is Related to';
                    }
                }
                
                // Calculate visual depth (indentation)
                const visualDepth = depth;
                const indent = Array(visualDepth).fill('<span class="tree-indent"></span>').join('');
                const expander = hasChildren ? `<button type="button" class="tree-expander" aria-label="Toggle"><i class="fas fa-caret-down"></i></button>` : '<span class="tree-placeholder"></span>';
                const childCount = childrenMap.get(id)?.length || 0;
                const countBadge = hasChildren ? `<span class="child-count" title="Children">${childCount}</span>` : '';
                const linkClass = isCurrent ? 'glossary-link current-glossary-link' : 'glossary-link';
                const link = `<a class="${linkClass}" href="/view/glossary/${encodeURIComponent(id)}">${escapeHtml(name)}</a>`;
                
                // Strategic source system display with hyperlinks (matching image style)
                let strategicSourceDisplay = '<span class="empty">-</span>';
                if (node.strategicSourceIds && node.strategicSourceIds.trim()) {
                    // Parse strategic source IDs and names: "id1:name1|id2:name2"
                    const sources = node.strategicSourceIds.split('|').filter(s => s.trim());
                    if (sources.length > 0) {
                        strategicSourceDisplay = sources.map(source => {
                            const [systemId, systemName] = source.split(':');
                            if (systemId && systemName) {
                                return `<a href="/view/system/${encodeURIComponent(systemId)}" class="system-link" style="color: #248567; text-decoration: none;">
                                    <i class="fas fa-layer-group" style="color: #248567;"></i> ${escapeHtml(systemName)}
                                </a>`;
                            }
                            return '';
                        }).filter(s => s).join(', ');
                    }
                } else if (node.strategicSourceSystem) {
                    // Fallback to comma-separated names if IDs not available
                    const systemNames = node.strategicSourceSystem.split(',').map(s => s.trim()).filter(s => s);
                    strategicSourceDisplay = systemNames.map(name => {
                        return `<span style="color: #248567;">
                            <i class="fas fa-layer-group" style="color: #248567;"></i> ${escapeHtml(name)}
                        </span>`;
                    }).join(', ');
                }
                
                return `<tr class="${isCurrent ? 'current-row' : ''}" data-id="${id}" data-parent-id="${parentId || ''}" data-depth="${visualDepth}" data-relation="${relation}">
                    <td><div class="tree-cell">${indent}${expander}${visualDepth>0?'<span class="tree-branch"></span>':''}<i class="fas fa-bookmark item-icon"></i><span class="glossary-name">${link}</span>${countBadge}</div></td>
                    <td><span class="type-badge">${escapeHtml(type)}</span></td>
                    <td>${escapeHtml(relationshipDisplay)}</td>
                    <td><span title="${escapeHtml(desc)}">${escapeHtml(desc || '-')}</span></td>
                    <td>${strategicSourceDisplay}</td>
                    <td>${node.dataItems || 0}</td>
                    <td>${node.dataAttributes || 0}</td>
                    <td>${formatDate(node.lastUpdated) || 'N/A'}</td>
                </tr>`;
            }).join('');

            tbody.innerHTML = rowsHtml;
            const n = hierarchyRows.length;
            footer.textContent = n === 1 ? hierT('glossary.hierarchy.recordOne') : (hierT('glossary.hierarchy.recordCount') || '{count} records').replace('{count}', n);
            
            // Build parent map for interactions
            const parentMap = new Map();
            items.forEach(item => {
                if (item.parentId) {
                    if (!parentMap.has(item.parentId)) {
                        parentMap.set(item.parentId, []);
                    }
                    parentMap.get(item.parentId).push(item.id);
                }
            });
            
            const hierarchyRowsObj = {
                rows: hierarchyRows,
                parentMap: parentMap
            };
            
            // Initialize interactions
            initGlossariesInteractions(tbody.closest('.hierarchy-table-wrapper'), hierarchyRowsObj);
        } catch (e) {
            console.error('[Hierarchy] Failed to load hierarchy:', e);
            console.error('[Hierarchy] Error stack:', e.stack);
            console.error('[Hierarchy] Error details:', {
                message: e.message,
                name: e.name,
                glossaryId: glossaryId
            });
            tbody.innerHTML = `<tr><td colspan="8" style="color:var(--danger,#b91c1c);padding:1rem;text-align:center;">Failed to load hierarchy data: ${e.message || 'Unknown error'}<br><small>Check console for details</small></td></tr>`;
            footer.textContent = (window.I18n && window.I18n.t('glossary.hierarchy.zeroRecords')) || '0 records';
        }
    }

    // Helper functions for rendering
    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function formatDate(dateString) {
        if (!dateString) return 'N/A';
        try {
            const date = new Date(dateString);
            return date.toLocaleDateString();
        } catch (e) {
            return 'N/A';
        }
    }

    // Build direct lineage tree for glossaries (same as System facet)
    function buildDirectLineageTree(glossaries, currentId) {
        const byId = new Map();
        glossaries.forEach(g => {
            const id = g.ID ?? g.id;
            byId.set(id, g);
        });
        
        console.log('Building lineage tree for glossary ID:', currentId);
        console.log('Available glossaries:', glossaries.map(g => ({ id: g.ID ?? g.id, name: g.name || g.Name, parent_id: g.parent_id ?? g.Parent_ID ?? g.parentId })));
        
        // Find all ancestors (parents, grandparents, great-grandparents, etc.) of the current glossary
        const ancestors = new Set();
        let current = byId.get(currentId);
        console.log('Current glossary:', current);
        
        while (current) {
            const parentId = current.parent_id ?? current.Parent_ID ?? current.parentId;
            console.log('Looking for parent ID:', parentId);
            if (parentId && parentId !== 0 && byId.has(parentId)) {
                ancestors.add(parentId);
                current = byId.get(parentId);
                console.log('Found ancestor:', current);
            } else {
                break;
            }
        }
        
        // Find all descendants (children, grandchildren, great-grandchildren, etc.) of the current glossary
        const descendants = new Set();
        function findDescendants(id) {
            glossaries.forEach(g => {
                const parentId = g.parent_id ?? g.Parent_ID ?? g.parentId;
                if (parentId === id) {
                    const childId = g.ID ?? g.id;
                    descendants.add(childId);
                    console.log('Found descendant:', g);
                    findDescendants(childId); // Recursively find all descendants
                }
            });
        }
        findDescendants(currentId);
        
        // Find all siblings (other children of the same parent)
        const siblings = new Set();
        const currentGlossary = byId.get(currentId);
                            if (currentGlossary) {
            const currentParentId = currentGlossary.parent_id ?? currentGlossary.Parent_ID ?? currentGlossary.parentId;
            console.log('Current parent ID:', currentParentId);
            if (currentParentId) {
                glossaries.forEach(g => {
                    const parentId = g.parent_id ?? g.Parent_ID ?? g.parentId;
                    if (parentId === currentParentId && (g.ID ?? g.id) !== currentId) {
                        siblings.add(g.ID ?? g.id);
                        console.log('Found sibling:', g);
                    }
                });
            }
        }
        
        // CRITICAL: Find children of siblings (nieces and nephews)
        const childrenOfSiblings = new Set();
        siblings.forEach(siblingId => {
            glossaries.forEach(g => {
                const parentId = g.parent_id ?? g.Parent_ID ?? g.parentId;
                if (parentId === siblingId) {
                    childrenOfSiblings.add(g.ID ?? g.id);
                    console.log('Found child of sibling (niece/nephew):', g);
                }
            });
        });
        
        // CRITICAL: Find children of siblings of parent (cousins) - SIMPLIFIED
        const childrenOfParentSiblings = new Set();
        if (currentGlossary) {
            const currentParentId = currentGlossary.parent_id ?? currentGlossary.Parent_ID ?? currentGlossary.parentId;
            if (currentParentId) {
                const parent = byId.get(currentParentId);
                if (parent) {
                    const grandparentId = parent.parent_id ?? parent.Parent_ID ?? parent.parentId;
                    if (grandparentId) {
                        // Find siblings of parent (uncles/aunts)
                        glossaries.forEach(uncleAunt => {
                            const uncleAuntParentId = uncleAunt.parent_id ?? uncleAunt.Parent_ID ?? uncleAunt.parentId;
                            if (uncleAuntParentId === grandparentId && (uncleAunt.ID ?? uncleAunt.id) !== currentParentId) {
                                console.log('Found uncle/aunt:', uncleAunt);
                                // Find children of this uncle/aunt (cousins)
                                glossaries.forEach(g => {
                                    const parentId = g.parent_id ?? g.Parent_ID ?? g.parentId;
                                    if (parentId === (uncleAunt.ID ?? uncleAunt.id)) {
                                        childrenOfParentSiblings.add(g.ID ?? g.id);
                                        console.log('Found cousin:', g);
                                    }
                                });
                            }
                        });
                    }
                }
            }
        }
        
        console.log('Ancestors:', Array.from(ancestors));
        console.log('Descendants:', Array.from(descendants));
        console.log('Siblings:', Array.from(siblings));
        console.log('Children of Siblings (Nieces/Nephews):', Array.from(childrenOfSiblings));
        console.log('Children of Parent Siblings (Cousins):', Array.from(childrenOfParentSiblings));
        
        // CRITICAL: Ensure we ALWAYS include basic relationships
        const basicRelationships = new Set([currentId, ...ancestors, ...descendants, ...siblings]);
        console.log('Glossary - Basic relationships:', Array.from(basicRelationships));
        
        // Include the current glossary, all its ancestors, all its descendants, all its siblings, nieces/nephews, and cousins
        const includedIds = new Set([
            ...basicRelationships,        // CRITICAL: Always include basic relationships
            ...childrenOfSiblings,        // CRITICAL: Children of siblings (nieces/nephews)
            ...childrenOfParentSiblings   // CRITICAL: Children of parent siblings (cousins)
        ]);
        
        console.log('Glossary - Final included IDs:', Array.from(includedIds));
        
        // Filter glossaries to include the COMPLETE EXTENDED FAMILY TREE
        let result = glossaries.filter(g => {
            const id = g.ID ?? g.id;
            return includedIds.has(id);
        });
        
        // FALLBACK: If no extended family found, ensure we at least have basic relationships
        if (result.length <= 1) {
            console.log('Glossary - FALLBACK: Using basic relationships only');
            result = glossaries.filter(g => {
                const id = g.ID ?? g.id;
                return basicRelationships.has(id);
            });
        }
        
        console.log('Final COMPLETE FAMILY TREE glossaries:', result);
        return result;
    }

    // Build full hierarchy tree for glossaries (same as System facet)
    function buildFullHierarchyTree(glossaries, currentId) {
        console.log('Glossary - Building full hierarchy tree with glossaries:', glossaries.length);
        console.log('Glossary - Current ID:', currentId);
        
        const byId = new Map();
        const childrenMap = new Map();

        const getId = g => g.ID ?? g.id;
        const getParentId = g => g.parent_id ?? g.Parent_ID ?? g.parentId ?? null;

        glossaries.forEach(g => {
            const id = getId(g);
            const parentId = getParentId(g);
            byId.set(id, g);
            if (!childrenMap.has(parentId)) childrenMap.set(parentId, []);
            childrenMap.get(parentId).push(g);
        });
        
        console.log('Glossary - byId map:', byId);
        console.log('Glossary - childrenMap:', childrenMap);

        // Find top-most ancestor (root)
        function findRoot(id) {
            const glossary = byId.get(id);
            if (!glossary) return id;
            const pid = getParentId(glossary);
            return pid && byId.has(pid) ? findRoot(pid) : id;
        }
        const rootId = findRoot(currentId);

        // Recursive tree builder
        function buildNode(id, depth = 0, visited = new Set(), parentId = null) {
            if (visited.has(id)) return null;
            visited.add(id);

            const node = byId.get(id);
            if (!node) return null;

            const children = childrenMap.get(id) || [];
            const childNodes = children.map(c => buildNode(getId(c), depth + 1, visited, id)).filter(Boolean);

            return { 
                node, 
                depth, 
                parentId, 
                hasChildren: childNodes.length > 0, 
                children: childNodes 
            };
        }

        const rootNode = buildNode(rootId);

        // Flatten recursively for rendering and tracking parent relationships
        const flattened = [];
        (function flatten(n) {
            if (!n) return;
            flattened.push({
                node: n.node,
                depth: n.depth,
                parentId: n.parentId,
                hasChildren: n.hasChildren
            });
            n.children.forEach(flatten);
        })(rootNode);

        console.log(`Full hierarchy built for ${currentId}: ${flattened.length} glossaries total`);
        return flattened;
    }

    // Build hierarchy tree for glossaries (same as System facet)
    function buildHierarchyTree(glossaries, rootId) {
        const byParent = new Map();
        const byId = new Map();
        glossaries.forEach(g => {
            const id = g.ID ?? g.id;
            const parentId = g.parent_id ?? g.Parent_ID ?? g.parentId ?? null;
            byId.set(id, g);
            if (!byParent.has(parentId)) byParent.set(parentId, []);
            byParent.get(parentId).push(g);
        });
        byParent.forEach(list => list.sort((a,b) => String(a.name||a.Name||'').localeCompare(String(b.name||b.Name||''))));

        // Compute child counts recursively
        const childCount = new Map();
        function countDescendants(id) {
            const children = byParent.get(id) || [];
            let total = children.length;
            children.forEach(c => { total += countDescendants(c.ID ?? c.id); });
            childCount.set(id, total);
            return total;
        }
        countDescendants(rootId);

        // Build DFS including root itself
        const result = [];
        function dfs(node, depth) {
            const id = node.ID ?? node.id;
            result.push({ node, depth, childCount: childCount.get(id) || 0, hasChildren: (byParent.get(id) || []).length > 0 });
            const children = byParent.get(id) || [];
            children.forEach(child => dfs(child, depth + 1));
        }
        const root = byId.get(rootId);
        if (root) dfs(root, 0);
        else (byParent.get(rootId) || []).forEach(child => dfs(child, 0));
        return { rows: result, parentMap: new Map([...byId.entries()].map(([i, n]) => [i, n.Parent_ID ?? n.parent_id ?? null])) };
    }

    // Initialize glossaries interactions (adapted for existing HTML structure)
    function initGlossariesInteractions(containerEl, hierarchyRows) {
        const collapsed = new Set();
        const parentMap = hierarchyRows.parentMap;
        const tbody = containerEl ? containerEl.querySelector('tbody') : document.getElementById('hierarchyTbody');
        if (!tbody) return;
        
        // Build a map of parent ID to child rows for faster lookup
        const childrenByParent = new Map();
        tbody.querySelectorAll('tr').forEach(tr => {
            const parentId = tr.getAttribute('data-parent-id');
            if (parentId) {
                if (!childrenByParent.has(parentId)) {
                    childrenByParent.set(parentId, []);
                }
                childrenByParent.get(parentId).push(tr);
            }
        });
        
        function toggleChildren(parentId, isCollapsed) {
            const children = childrenByParent.get(String(parentId)) || [];
            children.forEach(childTr => {
                const childId = childTr.getAttribute('data-id');
                const childParentId = childTr.getAttribute('data-parent-id');
                
                if (isCollapsed) {
                    // Hide this child and all its descendants
                    childTr.style.display = 'none';
                    childTr.classList.add('collapsed');
                    // Recursively hide all descendants
                    toggleChildren(childId, true);
                } else {
                    // Show this child
                    childTr.style.display = '';
                    childTr.classList.remove('collapsed');
                    // Recursively show children if parent is not collapsed
                    if (!collapsed.has(String(childId))) {
                        toggleChildren(childId, false);
                    }
                }
            });
        }
        
        function updateVisibility() {
            // Update all rows based on collapsed state
            tbody.querySelectorAll('tr').forEach(tr => {
                const id = tr.getAttribute('data-id');
                const parentId = tr.getAttribute('data-parent-id');
                
                // Check if any ancestor is collapsed
                let shouldHide = false;
                let currentParentId = parentId;
                const visited = new Set();
                
                while (currentParentId && !shouldHide && !visited.has(currentParentId)) {
                    visited.add(currentParentId);
                    if (collapsed.has(String(currentParentId))) {
                        shouldHide = true;
                        break;
                    }
                    // Find the parent row to get its parent ID
                    const parentRow = Array.from(tbody.querySelectorAll('tr')).find(r => 
                        r.getAttribute('data-id') === currentParentId
                    );
                    if (parentRow) {
                        currentParentId = parentRow.getAttribute('data-parent-id');
                    } else {
                        break;
                    }
                }
                
                if (shouldHide) {
                    tr.style.display = 'none';
                    tr.classList.add('collapsed');
                } else {
                    tr.style.display = '';
                    tr.classList.remove('collapsed');
                }
            });
            
            // Update expander button states
            tbody.querySelectorAll('tr').forEach(tr => {
                const id = tr.getAttribute('data-id');
                const btn = tr.querySelector('.tree-expander');
                if (btn) {
                    if (collapsed.has(String(id))) {
                        btn.classList.add('collapsed');
                    } else {
                        btn.classList.remove('collapsed');
                    }
                }
            });
        }
        
        tbody.addEventListener('click', (e) => {
            const button = e.target.closest('.tree-expander');
            if (button) {
                const tr = button.closest('tr');
                const id = tr.getAttribute('data-id');
                
                // Toggle collapsed state
                const wasCollapsed = collapsed.has(String(id));
                if (wasCollapsed) {
                    collapsed.delete(String(id));
                } else {
                    collapsed.add(String(id));
                }
                
                // Immediately update visibility
                updateVisibility();
            }
        });
        
        // Initial visibility update
        updateVisibility();
    }

