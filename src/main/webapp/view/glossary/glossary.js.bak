                            </div>
                            <!-- Dataset Lineage Filter Menu -->
                            <div class="map-filter-menu" id="${mapId}FilterMenuDataset" data-map-type="dataset-lineage" style="display:none;">
                                <div class="map-filter-category">
                                    <div class="map-filter-category-header">DATASET</div>
                                    <div class="map-filter-option">
                                        <input type="checkbox" id="filterGlossaryDatasetLineage" checked>
                                        <label for="filterGlossaryDatasetLineage">Dataset Lineage</label>
                                    </div>
                                </div>
                                <div class="map-filter-separator"></div>
                                <div class="map-filter-category">
                                    <div class="map-filter-category-header">TYPE</div>
                                    <div id="${mapId}FilterDatasetTypeOptions" class="map-filter-options-container">
                                        <!-- Dynamically populated -->
                                    </div>
                                </div>
                                <div class="map-filter-separator"></div>
                                <div class="map-filter-category">
                                    <div class="map-filter-category-header">LIFECYCLE</div>
                                    <div id="${mapId}FilterDatasetLifecycleOptions" class="map-filter-options-container">
                                        <!-- Dynamically populated -->
                                    </div>
                                </div>
                            </div>
                            <!-- System Lineage Filter Menu -->
                            <div class="map-filter-menu" id="${mapId}FilterMenuSystem" data-map-type="system-lineage" style="display:none;">
                                <div class="map-filter-category">
                                    <div class="map-filter-category-header">SYSTEM</div>
                                    <div class="map-filter-option">
                                        <input type="checkbox" id="filterGlossarySystemLineage" checked>
                                        <label for="filterGlossarySystemLineage">System Lineage</label>
                                    </div>
                                </div>
                                <div class="map-filter-category">
                                    <div class="map-filter-category-header">CLASSIFICATION</div>
                                    <div id="${mapId}FilterClassificationOptions" class="map-filter-options-container">
                                        <!-- Dynamically populated -->
                                    </div>
                                </div>
                                <div class="map-filter-separator"></div>
                                <div class="map-filter-category">
                                    <div class="map-filter-category-header">TYPE</div>
                                    <div id="${mapId}FilterTypeOptions" class="map-filter-options-container">
                                        <!-- Dynamically populated -->
                                    </div>
                                </div>
                                <div class="map-filter-separator"></div>
                                <div class="map-filter-category">
                                    <div class="map-filter-category-header">LIFECYCLE</div>
                                    <div id="${mapId}FilterLifecycleOptions" class="map-filter-options-container">
                                        <!-- Dynamically populated -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Toolbar Buttons -->
                    <div class="map-toolbar-buttons">
                        <button type="button" class="map-toolbar-btn" id="${mapId}ToggleLabels" title="Toggle labels">
                            <i class="fas fa-exchange-alt"></i>
                        </button>
                        <div class="map-toolbar-separator"></div>
                        <button type="button" class="map-toolbar-btn" id="${mapId}ZoomIn" title="Zoom in">
                            <i class="fas fa-search-plus"></i>
                        </button>
                        <button type="button" class="map-toolbar-btn" id="${mapId}ZoomOut" title="Zoom out">
                            <i class="fas fa-search-minus"></i>
                        </button>
                        <div class="map-toolbar-separator"></div>
                        <button type="button" class="map-toolbar-btn" id="${mapId}Redraw" title="Redraw">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                        <button type="button" class="map-toolbar-btn" id="${mapId}Reset" title="Reset">
                            <i class="fas fa-undo"></i>
                        </button>
                        <button type="button" class="map-toolbar-btn" id="${mapId}Export" title="Export as PNG">
                            <i class="fas fa-save"></i>
                        </button>
                        <div class="map-toolbar-separator"></div>
                        <button type="button" class="map-toolbar-btn" id="${mapId}Navigator" title="Map navigator">
                            <i class="fas fa-eye"></i>
                        </button>
                        <button type="button" class="map-toolbar-btn" id="${mapId}Fullscreen" title="Fullscreen">
                            <i class="fas fa-external-link-alt"></i>
                        </button>
                        <button type="button" class="map-toolbar-btn" id="${mapId}Legend" title="Open the Legend" aria-label="Open the Legend – refer to the legend to identify the symbols used in the map (Insight Maps Palette)">
                            <i class="fas fa-list-ul"></i>
                        </button>
                        <div class="map-toolbar-separator"></div>
                        <button type="button" class="map-toolbar-btn" id="${mapId}SavePreferences" title="Save map settings">
                            <i class="fas fa-save"></i>
                        </button>
                        <button type="button" class="map-toolbar-btn" id="${mapId}ResetPreferences" title="Reset map settings to default">
                            <i class="fas fa-undo"></i>
                        </button>
                    </div>
                </div>
                
                <!-- Map Body -->
                <div class="interface-map-body" style="flex: 1; position: relative;">
                    <div class="interface-map-canvas" id="glossaryRelationshipsMapCanvas" style="width: 100%; height: 100%; position: relative;">
                        <div class="interface-map-loading" data-glossary-relationships-map-loading style="display:none; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; z-index: 10;">
                            <i class="fas fa-spinner fa-spin"></i>
                            <span>Building map...</span>
                        </div>
                    </div>
                    <div class="interface-map-side-panel" id="${mapId}SidePanel" style="display:none;">
                        <div class="map-side-panel-section">
                            <h4><i class="fas fa-info-circle"></i> Selection</h4>
                            <div class="selection-placeholder" data-glossary-relationships-map-placeholder>
                                Select a node to see its details.
                            </div>
                            <div class="selection-info" data-glossary-relationships-map-details style="display:none;"></div>
                        </div>
                        <div class="map-side-panel-section">
                            <h4 class="map-legend-palette-title"><i class="fas fa-layer-group"></i> Insight Maps Palette</h4>
                            <div data-glossary-relationships-map-legend></div>
                        </div>
                    </div>
                </div>
            </div>
        `;
    }

    // Setup glossary relationships map controls
    function setupGlossaryRelationshipsMapControls(glossaryId) {
        const mapId = 'glossaryRelationshipsMap';
        
        // Map type selector
        const mapTypeSelect = document.getElementById(`${mapId}TypeSelect`);
        if (mapTypeSelect) {
            mapTypeSelect.addEventListener('change', (e) => {
                const mapType = e.target.value;
                // Switch overlay and filter menus based on map type
                switchMapTypeMenus(mapType);
                if (window.GlossaryRelationshipsMap) {
                    window.GlossaryRelationshipsMap.setMapType(mapType);
                }
            });
        }
        
        // Function to switch overlay and filter menus based on map type
        function switchMapTypeMenus(mapType) {
            // Hide all overlay menus
            ['Glossary', 'Dataset', 'System'].forEach(type => {
                const menu = document.getElementById(`${mapId}OverlayMenu${type}`);
                if (menu) menu.style.display = 'none';
            });
            
            // Show appropriate overlay menu
            let overlayMenuType = 'Glossary';
            if (mapType === 'dataset-lineage') {
                overlayMenuType = 'Dataset';
            } else if (mapType === 'system-lineage') {
                overlayMenuType = 'System';
            }
            const activeOverlayMenu = document.getElementById(`${mapId}OverlayMenu${overlayMenuType}`);
            if (activeOverlayMenu) {
                activeOverlayMenu.style.display = '';
            }
            
            // Hide all filter menus
            ['Glossary', 'Dataset', 'System'].forEach(type => {
                const menu = document.getElementById(`${mapId}FilterMenu${type}`);
                if (menu) menu.classList.remove('open');
            });
            
            // Reset overlay button text
            const overlayBtn = document.getElementById(`${mapId}OverlayBtn`);
            if (overlayBtn) {
                overlayBtn.querySelector('span').textContent = 'None';
            }
            
            // Clear active overlays
            document.querySelectorAll('.overlay-menu-item').forEach(i => i.classList.remove('active'));
            
            // Clear overlay on map
            if (window.GlossaryRelationshipsMap) {
                window.GlossaryRelationshipsMap.setOverlay('none');
            }
            
            // Hops Count: show for System Lineage and Data Lineage only
            const hopsGroup = document.getElementById(`${mapId}HopsGroup`);
            if (hopsGroup) {
                hopsGroup.style.display = (mapType === 'system-lineage' || mapType === 'dataset-lineage') ? '' : 'none';
            }
        }
        
        // Layout selector
        const layoutSelect = document.getElementById(`${mapId}LayoutSelect`);
        if (layoutSelect) {
            layoutSelect.addEventListener('change', (e) => {
                if (window.GlossaryRelationshipsMap) {
                    window.GlossaryRelationshipsMap.setLayout(e.target.value);
                }
            });
        }
        
        // Hops Count (1-99, default 15) - System/Data lineage
        const hopsInput = document.getElementById(`${mapId}HopsCount`);
        if (hopsInput) {
            hopsInput.addEventListener('change', (e) => {
                let val = parseInt(e.target.value, 10);
                if (isNaN(val) || val < 1) val = 1;
                if (val > 99) val = 99;
                e.target.value = val;
                if (window.GlossaryRelationshipsMap && typeof window.GlossaryRelationshipsMap.setHopsCount === 'function') {
                    window.GlossaryRelationshipsMap.setHopsCount(val);
                }
            });
        }

        // Overlay dropdown
        const overlayBtn = document.getElementById(`${mapId}OverlayBtn`);
        const overlayMenus = {
            'glossary-lineage': document.getElementById(`${mapId}OverlayMenuGlossary`),
            'dataset-lineage': document.getElementById(`${mapId}OverlayMenuDataset`),
            'system-lineage': document.getElementById(`${mapId}OverlayMenuSystem`)
        };
        
        if (overlayBtn) {
            overlayBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const currentMapType = mapTypeSelect ? mapTypeSelect.value : 'glossary-lineage';
                let activeMenu;
                if (currentMapType === 'glossary-lineage') {
                    activeMenu = overlayMenus['glossary-lineage'];
                } else if (currentMapType === 'dataset-lineage') {
                    activeMenu = overlayMenus['dataset-lineage'];
                } else if (currentMapType === 'system-lineage') {
                    activeMenu = overlayMenus['system-lineage'];
                }
                
                if (activeMenu) {
                    activeMenu.classList.toggle('open');
                    // Close other menus
                    Object.values(overlayMenus).forEach(menu => {
                        if (menu && menu !== activeMenu) {
                            menu.classList.remove('open');
                        }
                    });
                }
                // Close filter menus
                Object.values(filterMenus).forEach(menu => {
                    if (menu) menu.classList.remove('open');
                });
            });
        }

        // Setup overlay menu item click handlers
        Object.values(overlayMenus).forEach(overlayMenu => {
            if (overlayMenu) {
                overlayMenu.querySelectorAll('.overlay-menu-item').forEach(item => {
                    item.addEventListener('click', (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        
                        const overlayType = e.currentTarget.getAttribute('data-overlay');
                        const wasActive = e.currentTarget.classList.contains('active');
                        
                        overlayMenu.querySelectorAll('.overlay-menu-item').forEach(i => i.classList.remove('active'));
                        
                        if (!wasActive) {
                            e.currentTarget.classList.add('active');
                            if (overlayBtn) {
                                overlayBtn.querySelector('span').textContent = e.currentTarget.textContent.trim();
                            }
                            if (window.GlossaryRelationshipsMap) {
                                window.GlossaryRelationshipsMap.setOverlay(overlayType);
                            }
                        } else {
                            if (overlayBtn) {
                                overlayBtn.querySelector('span').textContent = 'None';
                            }
                            if (window.GlossaryRelationshipsMap) {
                                window.GlossaryRelationshipsMap.setOverlay('none');
                            }
                        }
                        
                        overlayMenu.classList.remove('open');
                    });
                });
            }
        });

        // Clear overlays buttons
        ['Glossary', 'Dataset', 'System'].forEach(type => {
            const clearBtn = document.getElementById(`${mapId}ClearOverlaysBtn${type}`);
            if (clearBtn) {
                clearBtn.addEventListener('click', () => {
                    document.querySelectorAll('.overlay-menu-item').forEach(i => i.classList.remove('active'));
                    if (overlayBtn) overlayBtn.querySelector('span').textContent = 'None';
                    if (window.GlossaryRelationshipsMap) {
                        window.GlossaryRelationshipsMap.setOverlay('none');
                    }
                    const menu = overlayMenus[type.toLowerCase() + '-lineage'];
                    if (menu) menu.classList.remove('open');
                });
            }
        });

        // Overlay grid button: overlay fields as columns dropdown
        const overlayGridBtn = document.getElementById(`${mapId}OverlayGrid`);
        const overlayColumnsMenuEl = document.getElementById(`${mapId}OverlayColumnsMenu`);
        const overlayColumnsOptions = document.getElementById(`${mapId}OverlayColumnsOptions`);
        if (overlayGridBtn && overlayColumnsMenuEl && overlayColumnsOptions) {
            function populateOverlayColumnsMenu() {
                overlayColumnsOptions.innerHTML = '';
                const overlayType = window.GlossaryRelationshipsMap && window.GlossaryRelationshipsMap.getState ? (window.GlossaryRelationshipsMap.getState().overlay || '') : '';
                if (!overlayType || overlayType === 'none') {
                    overlayColumnsOptions.innerHTML = '<div class="map-overlay-columns-empty">Select an overlay first.</div>';
                    return;
                }
                const columns = window.OverlayColumns && window.OverlayColumns.getOverlayColumns ? window.OverlayColumns.getOverlayColumns(overlayType) : [];
                const selectedIds = window.GlossaryRelationshipsMap && typeof window.GlossaryRelationshipsMap.getOverlayColumns === 'function' ? window.GlossaryRelationshipsMap.getOverlayColumns(overlayType) : [];
                if (!columns || columns.length === 0) {
                    overlayColumnsOptions.innerHTML = '<div class="map-overlay-columns-empty">No columns for this overlay.</div>';
                    return;
                }
                columns.forEach(col => {
                    const div = document.createElement('div');
                    div.className = 'map-filter-option';
                    const input = document.createElement('input');
                    input.type = 'checkbox';
                    input.id = 'overlayCol_glossary_' + overlayType + '_' + col.id;
                    input.checked = selectedIds.indexOf(col.id) !== -1;
                    input.dataset.columnId = col.id;
                    const label = document.createElement('label');
                    label.htmlFor = input.id;
                    label.textContent = col.label;
                    div.appendChild(input);
                    div.appendChild(label);
                    input.addEventListener('change', () => {
                        const checked = Array.from(overlayColumnsOptions.querySelectorAll('input:checked')).map(i => i.dataset.columnId);
                        if (window.GlossaryRelationshipsMap && typeof window.GlossaryRelationshipsMap.setOverlayColumns === 'function') {
                            window.GlossaryRelationshipsMap.setOverlayColumns(overlayType, checked);
                        }
                    });
                    overlayColumnsOptions.appendChild(div);
                });
            }
            overlayGridBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                Object.values(filterMenus).forEach(menu => { if (menu) menu.classList.remove('open'); });
                Object.values(overlayMenus).forEach(menu => { if (menu) menu.classList.remove('open'); });
                const isOpen = overlayColumnsMenuEl.classList.toggle('open');
                if (isOpen) {
                    overlayColumnsMenuEl.style.display = 'block';
                    populateOverlayColumnsMenu();
                    const rect = overlayGridBtn.getBoundingClientRect();
                    overlayColumnsMenuEl.style.position = 'fixed';
                    overlayColumnsMenuEl.style.left = rect.left + 'px';
                    overlayColumnsMenuEl.style.top = (rect.bottom + 4) + 'px';
                    overlayColumnsMenuEl.style.minWidth = '200px';
                } else {
                    overlayColumnsMenuEl.style.display = 'none';
                }
                overlayGridBtn.classList.toggle('active', isOpen);
            });
        }

        // Filter dropdown
        const filterBtn = document.getElementById(`${mapId}FilterBtn`);
        const filterMenus = {
            'glossary-lineage': document.getElementById(`${mapId}FilterMenuGlossary`),
            'dataset-lineage': document.getElementById(`${mapId}FilterMenuDataset`),
            'system-lineage': document.getElementById(`${mapId}FilterMenuSystem`)
        };
        
        if (filterBtn) {
            filterBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const currentMapType = mapTypeSelect ? mapTypeSelect.value : 'glossary-lineage';
                let activeMenu;
                if (currentMapType === 'glossary-lineage') {
                    activeMenu = filterMenus['glossary-lineage'];
                } else if (currentMapType === 'dataset-lineage') {
                    activeMenu = filterMenus['dataset-lineage'];
                } else if (currentMapType === 'system-lineage') {
                    activeMenu = filterMenus['system-lineage'];
                }
                
                if (activeMenu) {
                    activeMenu.classList.toggle('open');
                    // Close other menus and overlay menus
                    Object.values(filterMenus).forEach(menu => {
                        if (menu && menu !== activeMenu) {
                            menu.classList.remove('open');
                        }
                    });
                    Object.values(overlayMenus).forEach(menu => {
                        if (menu) menu.classList.remove('open');
                    });
                }
            });
        }

        // Setup filter checkbox handlers
        // Relationship type filters (for glossary lineage)
        document.addEventListener('glossaryRelationshipsMapFilterOptionsUpdated', (event) => {
            const container = document.getElementById(`${mapId}FilterRelationshipTypeOptions`);
            if (container) {
                container.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
                    checkbox.addEventListener('change', () => {
                        updateFilters();
                    });
                });
            }
        });

        // Collapse/Expand section button
        const collapseBtn = document.getElementById(`${mapId}CollapseBtn`);
        const mapSection = document.getElementById('glossaryRelationshipsMapSection');
        if (collapseBtn && mapSection) {
            collapseBtn.addEventListener('click', () => {
                const container = mapSection.querySelector('.interface-map-container');
                const icon = collapseBtn.querySelector('i');
                
                if (container) {
                    const isCollapsed = container.style.display === 'none';
                    container.style.display = isCollapsed ? '' : 'none';
                    icon.className = isCollapsed ? 'fas fa-minus' : 'fas fa-plus';
                }
            });
        }

        // Toolbar buttons
        const zoomInBtn = document.getElementById(`${mapId}ZoomIn`);
        if (zoomInBtn) {
            zoomInBtn.addEventListener('click', () => {
                if (window.GlossaryRelationshipsMap) window.GlossaryRelationshipsMap.zoomIn();
            });
        }

        const zoomOutBtn = document.getElementById(`${mapId}ZoomOut`);
        if (zoomOutBtn) {
            zoomOutBtn.addEventListener('click', () => {
                if (window.GlossaryRelationshipsMap) window.GlossaryRelationshipsMap.zoomOut();
            });
        }

        const resetBtn = document.getElementById(`${mapId}Reset`);
        if (resetBtn) {
            resetBtn.addEventListener('click', () => {
                if (window.GlossaryRelationshipsMap) window.GlossaryRelationshipsMap.resetMap();
            });
        }

        const redrawBtn = document.getElementById(`${mapId}Redraw`);
        if (redrawBtn) {
            redrawBtn.addEventListener('click', () => {
                if (window.GlossaryRelationshipsMap) window.GlossaryRelationshipsMap.redrawMap();
            });
        }

        const exportBtn = document.getElementById(`${mapId}Export`);
        if (exportBtn) {
            exportBtn.addEventListener('click', () => {
                if (window.GlossaryRelationshipsMap) window.GlossaryRelationshipsMap.exportAsPng();
            });
        }

        const fullscreenBtn = document.getElementById(`${mapId}Fullscreen`);
        if (fullscreenBtn) {
            fullscreenBtn.addEventListener('click', () => {
                if (window.GlossaryRelationshipsMap) window.GlossaryRelationshipsMap.openFullscreen();
            });
        }

        const legendBtn = document.getElementById(`${mapId}Legend`);
        if (legendBtn && typeof window.setupMapLegendDropdown === 'function') {
            window.setupMapLegendDropdown(mapId + 'Legend', mapId + 'LegendDropdown', function() {
                return window.GlossaryRelationshipsMap && window.GlossaryRelationshipsMap.getLegendHtml ? window.GlossaryRelationshipsMap.getLegendHtml() : '';
            });
        } else if (legendBtn) {
            const sidePanel = document.getElementById(`${mapId}SidePanel`);
            legendBtn.addEventListener('click', () => {
                if (sidePanel) {
                    const isVisible = sidePanel.style.display !== 'none';
                    sidePanel.style.display = isVisible ? 'none' : 'flex';
                    legendBtn.classList.toggle('active', !isVisible);
                }
            });
        }

        const navigatorBtn = document.getElementById(`${mapId}Navigator`);
        if (navigatorBtn) {
            navigatorBtn.addEventListener('click', () => {
                if (window.GlossaryRelationshipsMap) window.GlossaryRelationshipsMap.toggleNavigator();
            });
        }
        
        // Save / Reset map preferences (BUDG-style)
        const savePrefsBtn = document.getElementById(`${mapId}SavePreferences`);
        if (savePrefsBtn) {
            savePrefsBtn.addEventListener('click', () => {
                if (window.GlossaryRelationshipsMap && typeof window.GlossaryRelationshipsMap.savePreferences === 'function') {
                    window.GlossaryRelationshipsMap.savePreferences();
                }
            });
        }
        const resetPrefsBtn = document.getElementById(`${mapId}ResetPreferences`);
        if (resetPrefsBtn) {
            resetPrefsBtn.addEventListener('click', () => {
                if (window.GlossaryRelationshipsMap && typeof window.GlossaryRelationshipsMap.resetPreferences === 'function') {
                    window.GlossaryRelationshipsMap.resetPreferences();
                }
            });
        }

        // Sync UI from saved preferences (BUDG-style)
        function syncUIFromPreferences(prefs) {
            if (!prefs) return;
            if (layoutSelect && prefs.layout) layoutSelect.value = prefs.layout;
            if (hopsInput && prefs.hopsCount) hopsInput.value = String(prefs.hopsCount);
            if (mapTypeSelect && prefs.mapType) {
                mapTypeSelect.value = prefs.mapType;
                switchMapTypeMenus(prefs.mapType);
            }
            const overlayLabels = { description: 'Description', stakeholders: 'Stakeholders', glossary: 'Glossary', datasets: 'Data Sets', attributes: 'Attributes', projects: 'Projects' };
            if (overlayBtn) {
                overlayBtn.querySelector('span').textContent = (prefs.overlay && prefs.overlay !== 'none' ? (overlayLabels[prefs.overlay] || prefs.overlay) : 'None');
            }
        }
        window.addEventListener('glossaryRelationshipsMapPreferencesLoaded', (e) => {
            syncUIFromPreferences(e.detail);
        });

        // Update filters function
        function updateFilters() {
            const currentMapType = mapTypeSelect ? mapTypeSelect.value : 'glossary-lineage';
            const filters = {};
            
            if (currentMapType === 'glossary-lineage') {
                // Get selected relationship types
                const relTypeCheckboxes = document.querySelectorAll(`#${mapId}FilterRelationshipTypeOptions input[type="checkbox"]:checked`);
                filters.relationshipTypes = Array.from(relTypeCheckboxes).map(cb => cb.getAttribute('data-rel-type'));
            }
            
            if (window.GlossaryRelationshipsMap) {
                window.GlossaryRelationshipsMap.setNodeFilters(filters);
            }
        }

        // Initialize menu visibility based on default map type
        if (mapTypeSelect) {
            switchMapTypeMenus(mapTypeSelect.value);
        }
    }

    // Helper function to set up relationships sub-tabs
    function setupRelationshipsSubTabs(glossaryId, view = null) {
        const subTabs = document.querySelectorAll('.relationships-sub-tabs .sub-tab');
        subTabs.forEach(function(btn){
            btn.addEventListener('click', function(){
                subTabs.forEach(function(b){ b.classList.remove('active'); });
                this.classList.add('active');

                const subTabType = this.getAttribute('data-sub-tab');
                const hierarchyContent = document.getElementById('hierarchyContent');
                const relationshipsContent = document.getElementById('relationshipsContent');

                if (subTabType === 'hierarchy') {
                    if (hierarchyContent) hierarchyContent.classList.add('active');
                    if (relationshipsContent) relationshipsContent.classList.remove('active');
                } else if (subTabType === 'relationships') {
                    if (hierarchyContent) hierarchyContent.classList.remove('active');
                    if (relationshipsContent) relationshipsContent.classList.add('active');

                    // Load relationships data when switching to relationships tab
                    // Pass current view state to filter pending changes
                    if (glossaryId) {
                        loadRelationshipsData(glossaryId, currentView);
                        setupAddRelationship(glossaryId);
                        
                        // Initialize map when relationships sub-tab is shown (map is within this sub-tab, below the table)
                        setTimeout(() => {
                            const mapCanvas = document.getElementById('glossaryRelationshipsMapCanvas');
                            if (mapCanvas && window.GlossaryRelationshipsMap) {
                                const mapState = window.GlossaryRelationshipsMap.getState();
                                if (!mapState || !mapState.initialized) {
                                    window.GlossaryRelationshipsMap.init(glossaryId, '#glossaryRelationshipsMapCanvas');
                                    if (typeof setupGlossaryRelationshipsMapControls === 'function') {
                                        setupGlossaryRelationshipsMapControls(glossaryId);
                                    }
                                }
                            }
                        }, 100);
                    }
                }
            });
        });
    }

    // Data tab sub-tabs setup moved to glossary-data-tab.js isolated module

                    // OLD FUNCTION REMOVED - Using System-style approach instead

        // Track last active tab (more reliable than querying DOM in some edge cases)
        let lastActiveTab = 'summary';

        // Tab switching logic
        document.addEventListener('DOMContentLoaded', function() {
            const glossaryId = parseId();
            
            // Traditional tab handling
            const tabs = document.querySelectorAll('.tab-container .tab');

                tabs.forEach(function(tab) {
                    tab.addEventListener('click', function() {
                        const tabName = this.getAttribute('data-tab');
                        console.log('[Glossary] Tab clicked:', tabName);
                        
                        // Toggle stakeholder-only edit mode based on active tab and auto CR state
                        if (window.EditDropdown && _hasActiveAutoCR && _canEditObject) {
                            if (tabName === 'stakeholders') {
                                window.EditDropdown.enableStakeholderOnlyEdit(`/view/glossary/glossary-edit.html?id=${glossaryId}`);
                            } else {
                                window.EditDropdown.disableStakeholderOnlyEdit();
                            }
                        }

                        // Remove active class from all tabs
                        tabs.forEach(function(t) { t.classList.remove('active'); });
                                this.classList.add('active');
                    lastActiveTab = tabName || 'summary';

                        // Get glossary ID
                        if (!glossaryId) {
                            console.error('[Glossary] No glossary ID found');
                            return;
                        }

                        // Handle tab content
                        const container = document.getElementById('glossaryViewContainer');
                        if (!container) {
                            console.error('[Glossary] Container not found');
                            return;
                        }

                        // ALWAYS get current view from toggle state (single source of truth)
                        const viewToUse = getCurrentViewMode();
                        console.log('[Glossary] Tab switch - using view mode:', viewToUse);

                        // Tab-specific content handling
                        console.log('[Glossary] Loading tab:', tabName, 'with view:', viewToUse);
                        switch (tabName) {
                            case 'summary':
                                // Show summary - reload glossary with current view
                                if (glossaryId) {
                                    console.log('[Glossary] Loading summary tab with view:', viewToUse);
                                    load(glossaryId, viewToUse);
                                }
                                break;

                            case 'stakeholders':
                                // Show stakeholders
                                console.log('[Glossary] Loading stakeholders tab with view:', viewToUse);
                                container.innerHTML = '<div id="glossaryStakeholdersContainer"></div>';
                                if (window.GlossaryStakeholderView && glossaryId) {
                                    window.GlossaryStakeholderView.init(glossaryId, viewToUse);
                                }
                                break;

                        case 'relationships': {
                            const hT = (k) => (window.I18n && window.I18n.t(k)) || k;
                            const hierZero = hT('glossary.hierarchy.zeroRecords');
                            const relLoading = hT('glossary.relationships.loading');
                            // Show relationships tab with hierarchy and relationships sub-tabs
                            console.log('[Glossary] Loading relationships tab with view:', viewToUse);
                    container.innerHTML = `
                                    <div class="relationships-container">
                                        <div class="relationships-sub-tabs">
                                            <button class="sub-tab active" data-sub-tab="hierarchy">${hT('glossary.hierarchy.subTabHierarchy')}</button>
                                            <button class="sub-tab" data-sub-tab="relationships">${hT('glossary.hierarchy.subTabRelationships')}</button>
                            </div>
                                        <div class="relationships-content">
                                            <div id="hierarchyContent" class="sub-tab-content active">
                                                <div class="relationships-hierarchy">
                                                    <div class="hierarchy-header">
                                                        <div class="hierarchy-title">${hT('glossary.hierarchy.title')}</div>
                                                        <div class="hierarchy-actions">
                                                            <button type="button" class="btn btn-secondary" id="editBtn2"><i class="fas fa-cog"></i></button>
                        </div>
                            </div>
                                                    <div class="hierarchy-table-wrapper">
                                                        <table class="hierarchy-table">
                                                            <thead>
                                                                <tr>
                                                                    <th>${hT('glossary.hierarchy.name')}</th>
                                                                    <th>${hT('glossary.hierarchy.type')}</th>
                                                                    <th>${hT('glossary.hierarchy.relationshipType')}</th>
                                                                    <th>${hT('glossary.hierarchy.definition')}</th>
                                                                    <th>${hT('glossary.hierarchy.strategicSourceSystem')}</th>
                                                                    <th>${hT('glossary.hierarchy.dataItems')}</th>
                                                                    <th>${hT('glossary.hierarchy.dataAttributes')}</th>
                                                                    <th>${hT('glossary.hierarchy.lastUpdated')}</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody id="hierarchyTbody">
                                                                <tr><td colspan="8" style="text-align:center;padding:2rem;color:var(--text-muted,#6b7280);">${hT('glossary.hierarchy.loading')}</td></tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <div class="hierarchy-footer" id="hierarchyFooter">
                                                        ${hierZero}
                                                    </div>
                                                </div>
                                            </div>
                                            <div id="relationshipsContent" class="sub-tab-content">
                                                <!-- Relationships Table Section -->
                                                <div class="relationships-hierarchy" style="margin-bottom: 1.5rem;">
                                                    <div class="hierarchy-header">
                                                        <div class="hierarchy-title">${hT('glossary.relationships.title')}</div>
                                                        <div class="hierarchy-actions">
                                                            <button type="button" id="addRelationshipBtn" class="btn btn-secondary" style="margin-right: 0.5rem;">
                                                                <i class="fas fa-plus"></i> ${hT('glossary.relationships.addRelationship')}
                                                            </button>
                                                            <button type="button" class="btn btn-secondary"><i class="fas fa-cog"></i><i class="fas fa-chevron-down" style="margin-left:.3rem;font-size:.7rem;"></i></button>
                                                        </div>
                                                    </div>
                                                    <div class="data-table-wrapper">
                                                        <table class="data-table">
                                                            <thead>
                                                                <tr>
                                                                    <th style="text-align: center;"><div class="th-content"><span>Relationship Type</span><i class="fas fa-sort"></i></div></th>
                                                                    <th style="text-align: center;"><div class="th-content"><span>Glossary</span><i class="fas fa-sort"></i></div></th>
                                                                    <th style="text-align: center;"><div class="th-content"><span>Glossary Type</span><i class="fas fa-sort"></i></div></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody id="relationshipsTableBody">
                                                                <tr><td colspan="3" style="text-align:center;padding:2rem;color:var(--text-muted,#6b7280);">${relLoading}</td></tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <div class="hierarchy-footer" id="relationshipsFooter">
                                                        ${hierZero}
                                                    </div>
                                                </div>
                                                
                                                <!-- Map Section (below relationships table) -->
                                                <div class="map-section" id="glossaryRelationshipsMapSection" style="margin-top: 1.5rem;">
                                                    ${getGlossaryRelationshipsMapHtml()}
                                                </div>
                                                
                                                <!-- Add Relationship Modal -->
                                                <div id="addRelationshipModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
                                                    <div style="background: white; padding: 2rem; border-radius: 8px; max-width: 500px; width: 90%; max-height: 90vh; overflow-y: auto;">
                                                        <h3 style="margin-top: 0; margin-bottom: 1.5rem;">Add Relationship</h3>
                                                        <form id="addRelationshipForm">
                                                            <div style="margin-bottom: 1rem;">
                                                                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Relationship Type <span style="color: red;">*</span></label>
                                                                <select id="relationshipTypeSelect" required style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px;">
                                                                    <option value="">Select Relationship Type</option>
                                                                </select>
                                </div>
                                                            <div style="margin-bottom: 1.5rem;">
                                                                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Target Glossary <span style="color: red;">*</span></label>
                                                                <select id="targetGlossarySelect" required style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px;">
                                                                    <option value="">Select Glossary</option>
                                                                </select>
                                                            </div>
                                                            <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                                                                <button type="button" id="cancelRelationshipBtn" class="btn btn-secondary">Cancel</button>
                                                                <button type="submit" id="saveRelationshipBtn" class="btn" style="background: #248567; color: white;">Save</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                </div>
                            </div>
                        </div>
                    `;

                            // Load hierarchy data and set up sub-tab functionality
                            if (glossaryId) {
                                loadGlossaryHierarchy(glossaryId);
                                setupRelationshipsSubTabs(glossaryId);
                                // Setup add relationship functionality
                                setTimeout(() => setupAddRelationship(glossaryId), 100);
                            }
                            }
                            break;

                        case 'data-quality':
                            // Show data quality tab
                            container.innerHTML = '<div id="glossaryDataQualityContainer"></div>';
                            if (window.GlossaryDataQualityView && glossaryId) {
                                window.GlossaryDataQualityView.init(glossaryId);
                            } else {
                                showPlaceholderContent(container, 'data-quality', 'fas fa-chart-line');
                            }
                            break;

                        case 'impact':
                            // Show impact tab
                            console.log('[Glossary] Loading impact tab with view:', viewToUse);
                            container.innerHTML = '<div id="impactContainer"><div class="loading">Loading impact...</div></div>';
                            if (window.loadGlossaryImpact && glossaryId) {
                                window.loadGlossaryImpact(glossaryId, viewToUse);
                            } else {
                                showPlaceholderContent(container, 'impact', 'fas fa-bullseye');
                            }
                            break;

                        case 'data':
                            // Show data tab using isolated module
                            container.innerHTML = '<div id="glossaryDataContainer"></div>';
                            if (window.GlossaryDataView && glossaryId) {
                                window.GlossaryDataView.init(glossaryId);
                            }
                            break;

                        case 'enterprise-catalog':
                            // Show enterprise catalog tab
                            container.innerHTML = '<div id="glossaryEnterpriseCatalogContainer"></div>';
                            if (window.GlossaryEnterpriseCatalogView && glossaryId) {
                                window.GlossaryEnterpriseCatalogView.init(glossaryId);
                            } else {
                                showPlaceholderContent(container, 'enterprise-catalog', 'fas fa-building');
                            }
                            break;

                        case 'history':
                            // Show history tab with history component
                            container.innerHTML = `
                                <div class="view-section" style="grid-column:1/-1;">
                                    <div id="glossaryHistoryContainer"></div>
                                </div>
                            `;
                            // Initialize history component for glossary
                            if (window.HistoryComponent && glossaryId) {
                                console.log('Initializing history component for Glossary with ID:', glossaryId);
                                window.HistoryComponent.initialize('Glossary', glossaryId, 'glossaryHistoryContainer');
                            } else {
                                console.error('HistoryComponent not available or glossaryId not found:', { HistoryComponent: !!window.HistoryComponent, glossaryId });
                            }
                            break;

                        case 'change':
                            // Show change tab
                            container.innerHTML = '<div id="glossaryChangeContainer"></div>';
                            if (window.ChangeTabComponent && glossaryId) {
                                window.ChangeTabComponent.initialize('glossary', glossaryId, 'glossaryChangeContainer');
                            } else {
                                showPlaceholderContent(container, 'change', 'fas fa-exchange-alt');
                            }
                            break;

                        default:
                            // Fallback for unknown tabs
                            showPlaceholderContent(container, tabName, 'fas fa-info-circle');
                            break;
                    }
                    if (typeof window.syncStakeholderVisibility === 'function') {
                        window.syncStakeholderVisibility('glossaryStakeholdersContainer');
                    }
                });
            });
        });
        
        // Initialize unified edit dropdown
        const glossaryId = parseId();
        if (window.EditDropdown && glossaryId != null) {
            (async () => {
                try {
                    // Check if rollup view is enabled
                    const isRollupViewEnabled = localStorage.getItem(`glossary_${glossaryId}_rollup_view`) === 'true';
                    
                    // Check Auto CR status and determine edit restrictions
                    let disableEditOption = false;
                    let disableEditReason = '';
                    try {
                        const statusRes = await fetch(`/api/pending-changes/status/Glossary/${glossaryId}`, {
                            method: 'GET',
                            credentials: 'include'
                        });
                        if (statusRes.ok) {
                            const statusData = await statusRes.json();
                            if (statusData.changeRequestId) {
                                // Get current user
                                const currentUserRes = await fetch('/api/me', { credentials: 'include' });
                                const currentUser = currentUserRes.ok ? await currentUserRes.json() : null;
                                const currentUserId = currentUser?.id != null ? currentUser.id : currentUser?.userId;

                                // Determine CR status - check from statusData first, then fallback to CR API
                                let crStatusName = statusData.crStatusName || '';
                                let crCreatedBy = statusData.crCreatedBy;
                                let isAutoCR = statusData.isAutoCR === true;

                                // If statusData doesn't have CR details, fetch from CR API
                                if (!isAutoCR && !crStatusName) {
                                    try {
                                        const crRes = await fetch(`/api/changerequests/${statusData.changeRequestId}`, { method: 'GET', credentials: 'include' });
                                        if (crRes.ok) {
                                            const crData = await crRes.json();
                                            const mandatoryWorkflow = crData.mandatoryWorkflow === true || crData.mandatoryWorkflow === 1;
                                            const pName = (crData.primaryName || crData.PrimaryName || '').toLowerCase();
                                            const summ = (crData.summary || crData.Summary || '').toLowerCase();
                                            isAutoCR = mandatoryWorkflow || pName.includes('auto-generated cr for') || summ.includes('auto-generated cr for');
                                            crStatusName = crData.statusName || crData.StatusName || '';
                                            crCreatedBy = crData.createdBy != null ? crData.createdBy : crData.Created_By;
                                        }
                                    } catch (e) { console.warn('[Glossary] Failed to fetch CR details:', e); }
                                }

                                // Check if CR is finished
                                const statusLower = (crStatusName || '').toLowerCase();
                                const isFinished = statusLower.includes('complete') || statusLower.includes('cancelled') || statusLower.includes('canceled') || statusLower.includes('closed') || statusLower.includes('reject');

                                if (isAutoCR && !isFinished) {
                                    const isRequester = crCreatedBy != null && currentUserId != null && String(crCreatedBy) === String(currentUserId);
                                    const isRunning = statusLower.includes('running') || statusLower.includes('in progress');
                                    console.log('[Glossary] Auto CR active: status=' + crStatusName + ', isRequester=' + isRequester);

                                    if (!isRequester) {
                                        disableEditOption = true;
                                        disableEditReason = 'Cannot edit: Only the requester can edit during an active Auto CR.';
                                    } else if (isRunning) {
                                        disableEditOption = true;
                                        disableEditReason = 'Cannot edit: Auto CR is ' + crStatusName + '. Wait for completion.';
                                    } else {
                                        // Requester + not running (e.g. Pending Start): allow editing
                                        console.log('[Glossary] Requester allowed to edit (Pending Start)');
                                    }
                                } else {
                                    console.log('[Glossary] No active Auto CR restriction (isAutoCR=' + isAutoCR + ', isFinished=' + isFinished + ')');
                                }
                            }
                        }
                    } catch (e) {
                        console.warn('[Glossary] Could not check CR status:', e);
                    }
                    
                    // Store auto CR state for stakeholder tab redirect
                    _hasActiveAutoCR = disableEditOption;
                    
                    window.EditDropdown.initialize('glossary', glossaryId, {
                        container: '.tab-actions',
                        editUrl: `/view/glossary/glossary-edit.html?id=${glossaryId}`,
                        hideEditOption: false,
                        disableEditOption: disableEditOption,
                        disableEditReason: disableEditReason,
                        customActions: [
                            {
                                category: 'OTHER ACTIONS',
                                label: isRollupViewEnabled ? 'Hide Rollup View' : 'Show Rollup View',
                                icon: isRollupViewEnabled ? 'fa-eye-slash' : 'fa-layer-group',
                                action: function() {
                                    toggleRollupView(glossaryId);
                                }
                            }
                        ]
                    });
                } catch (error) {
                    console.error('Failed to initialize edit dropdown:', error);
                }
            })();
        }
        
        // Function to toggle rollup view
        function toggleRollupView(glossaryId) {
            const currentState = localStorage.getItem(`glossary_${glossaryId}_rollup_view`) === 'true';
            const newState = !currentState;
            localStorage.setItem(`glossary_${glossaryId}_rollup_view`, newState.toString());
            
            // Update the dropdown menu text - find by icon class
            const rollupMenuItems = document.querySelectorAll('.edit-dropdown-item[data-action="custom"]');
            rollupMenuItems.forEach(item => {
                const icon = item.querySelector('i');
                if (icon && (icon.classList.contains('fa-layer-group') || icon.classList.contains('fa-eye-slash'))) {
                    const label = Array.from(item.childNodes).find(node => node.nodeType === 3); // Text node
                    if (newState) {
                        icon.className = 'fas fa-eye-slash';
                        if (label) label.textContent = ' Hide Rollup View';
                    } else {
                        icon.className = 'fas fa-layer-group';
                        if (label) label.textContent = ' Show Rollup View';
                    }
                }
            });
            
            // Update visual indicator
            updateRollupViewIndicator(glossaryId, newState);
            
            // Reload impact and data tabs if they're active
            const activeTab = document.querySelector('.tab.active');
            if (activeTab) {
                const tabName = activeTab.getAttribute('data-tab');
                if (tabName === 'impact' || tabName === 'data') {
                    const container = document.getElementById('glossaryViewContainer');
                    if (container) {
                        if (tabName === 'impact') {
                            container.innerHTML = '<div id="impactContainer"><div class="loading">Loading impact...</div></div>';
                            if (window.loadGlossaryImpact) {
                                window.loadGlossaryImpact(glossaryId, currentView);
                            }
                        } else if (tabName === 'data') {
                            container.innerHTML = '<div id="glossaryDataContainer"></div>';
                            if (window.GlossaryDataView) {
                                window.GlossaryDataView.init(glossaryId);
                            }
                        }
                    }
                }
            }
        }
        
        // Function to update rollup view indicator
        function updateRollupViewIndicator(glossaryId, isEnabled) {
            const breadcrumbElement = document.getElementById('glossaryBreadcrumb');
            if (!breadcrumbElement) return;
            
            // Remove existing indicator
            const existingIndicator = breadcrumbElement.parentElement.querySelector('.rollup-view-indicator');
            if (existingIndicator) {
                existingIndicator.remove();
            }
            
            // Add indicator if enabled
            if (isEnabled) {
                const indicator = document.createElement('div');
                indicator.className = 'rollup-view-indicator';
                indicator.textContent = 'Glossary | (Show Rollup View)';
                indicator.style.cssText = 'color: #9ca3af; font-size: 0.875rem; margin-top: 0.25rem;';
                breadcrumbElement.parentElement.insertBefore(indicator, breadcrumbElement.nextSibling);
            }
        }
        
        // Initialize rollup view indicator on page load
        const glossaryIdForIndicator = parseId();
        if (glossaryIdForIndicator) {
            const isRollupEnabled = localStorage.getItem(`glossary_${glossaryIdForIndicator}_rollup_view`) === 'true';
            updateRollupViewIndicator(glossaryIdForIndicator, isRollupEnabled);
        }
        
        // Function to update title/header without reloading entire page
        async function updateTitleOnly(id, view) {
            try {
                const titleElement = document.getElementById('glossaryTitle');
                if (titleElement) {
                    // Fetch glossary data to get updated name
                    const g = await window.BUDG_API_SERVICE.getGlossaryById(id, view === 'changes' ? 'changes' : null);
                    if (g && g.name) {
                        titleElement.textContent = escapeHtml(g.name);
                    }
                }
            } catch (error) {
                console.error('[Glossary] Error updating title:', error);
            }
        }
        
        // Listen for pending changes view switch event
        document.addEventListener('pendingChangesViewSwitch', async function(event) {
            const { view, facetType, objectId } = event.detail;
            if (facetType === 'Glossary' && objectId) {
                console.log('[Glossary] View switch event received:', view);
                currentView = view; // Update currentView to match toggle
                
                // Always update the title/header regardless of which tab is active
                await updateTitleOnly(objectId, view);
                
                // Get current active tab (use lastActiveTab as fallback to avoid stale/empty state)
                const activeTab = document.querySelector('.tab.active');
                const tabName = (activeTab && activeTab.getAttribute('data-tab')) ? activeTab.getAttribute('data-tab') : (lastActiveTab || 'summary');
                lastActiveTab = tabName || 'summary';
                
                // Reload current tab with new view
                const container = document.getElementById('glossaryViewContainer');
                if (container) {
                    switch (tabName) {
                        case 'summary':
                            // Clear old content immediately so we don't show "changes" data while switching to original
                            container.innerHTML = '<div class="view-section" style="grid-column: 1/-1;">Loading...</div>';
                            await load(objectId, view);
                            break;
                        case 'stakeholders':
                            // Clear old content immediately so we don't show "changes" data while switching to original
                            container.innerHTML = '<div id="glossaryStakeholdersContainer"><div class="loading">Loading stakeholders...</div></div>';
                            if (window.GlossaryStakeholderView) {
                                window.GlossaryStakeholderView.init(objectId, view);
                            }
                            break;
                        case 'impact':
                            // Clear old content immediately so we don't show "changes" data while switching to original
                            container.innerHTML = '<div id="impactContainer"><div class="loading">Loading impact...</div></div>';
                            if (window.loadGlossaryImpact) {
                                window.loadGlossaryImpact(objectId, view);
                            }
                            break;
                        case 'relationships':
                            // Reload relationships data with new view
                            // Check which sub-tab is active
                            const relationshipsSubTab = document.querySelector('#relationshipsContent');
                            if (relationshipsSubTab && relationshipsSubTab.classList.contains('active')) {
                                // Relationships sub-tab is active, reload it
                                loadRelationshipsData(objectId, view);
                            }
                            break;
                        default:
                            // For other tabs, just reload summary
                            await load(objectId, view);
                            break;
                    }
                }
                
                // Also reload documents with new view mode
                if (glossaryDocumentTable) {
                    glossaryDocumentTable.setViewMode(view);
                }
            }
        });

    // Make functions globally available
    window.viewGlossary = viewGlossary;
})();



