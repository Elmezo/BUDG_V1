<?xml version="1.0" encoding="UTF-8"?>
<Context reloadable="false" antiResourceLocking="true">
    <WatchedResource>WEB-INF/web.xml</WatchedResource>
    <WatchedResource>META-INF/context.xml</WatchedResource>
    <WatchedResource>${catalina.base}/conf/web.xml</WatchedResource>
    
    <!-- Increase web resources cache size to avoid warnings -->
    <!-- cacheMaxSize: Maximum total cache size in KB (1 GB = 1048576 KB) -->
    <!-- cacheObjectMaxSize: Maximum size per object in KB (must be <= maxSize/20) -->
    <!-- Note: If cacheMaxSize is not applied at server level, Tomcat defaults to ~10 MB, so objectMaxSize must be <= 512 KB -->
    <!-- Setting cacheObjectMaxSize to 512 KB to comply with Tomcat's default maxSize/20 limit -->
    <Resources 
        cacheMaxSize="1048576" 
        cacheObjectMaxSize="512"
        cacheTtl="60000"
        className="org.apache.catalina.webresources.StandardRoot">
    </Resources>
</Context>
