# Copy to project root `.env` or set as OS environment variables.
# Values below were restored from the historical `src/main/resources/.env` (first repo commit).
# Rotate JWT_SECRET_KEY (and DB password) in production — this file may be committed.

# JWT (required, min 32 bytes UTF-8)
JWT_SECRET_KEY=81gP4j7KkHNKM9t5u1G9EnFtByKdmBNiGY0OlEUnaUkTk6ZXiDpbLB5bqW5LUxBt

# Database
DB_URL=jdbc:mysql://localhost:3306/project
DB_USERNAME=root
DB_PASSWORD=

# Bulk validation Python service — same value in Java (EnvFileLoader) and Python (repo root `.env`; budg_db_config loads it)
# Dev default only; change in production.
BULK_VALIDATION_API_KEY=BUDG_DEV_BULK_VALIDATION_LOCALHOST_ONLY

HTTPS_ONLY=false
ALLOWED_ORIGINS=http://localhost:8080,https://localhost:8080

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME_MINUTES=15
RESET_TIME_HOURS=1
LOG_LEVEL=INFO

LDAP_ENABLED=true
LDAP_HOST=localhost
LDAP_PORT=10389
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_DN=ou=people,dc=example,dc=com
LDAP_GROUP_DN=ou=group,dc=example,dc=com
LDAP_USE_SSL=false
