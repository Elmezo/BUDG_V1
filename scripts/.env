# Environment Variables for BUDG Platform
# Copy this file to .env and set your actual values

# JWT Secret Key (REQUIRED)
# Generate a strong secret key: openssl rand -base64 64
JWT_SECRET_KEY=your-very-long-random-secret-key-at-least-512-bits-long

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/project
DB_USERNAME=root
DB_PASSWORD=

# Security Settings
# Set to true in production
HTTPS_ONLY=false

# CORS Settings
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8080,https://localhost:8080

# Rate Limiting Settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME_MINUTES=15
RESET_TIME_HOURS=1

# Logging Level
LOG_LEVEL=INFO

# LDAP Configuration
LDAP_ENABLED=true
LDAP_HOST=localhost
LDAP_PORT=10389
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_DN=ou=people,dc=example,dc=com
LDAP_GROUP_DN=ou=group,dc=example,dc=com
LDAP_USE_SSL=false
