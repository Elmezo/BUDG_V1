# ============================================
# BUDG Platform - Environment Configuration
# ============================================
# Auto-generated by installer.py
# Manual edits are preserved on re-run.

# --------------------------------------------
# JWT Secret Key (REQUIRED)
# --------------------------------------------
# Auto-generated on first install. Do NOT change unless rotating keys.
JWT_SECRET_KEY=

# --------------------------------------------
# Database Configuration
# --------------------------------------------
DB_URL=jdbc:mysql://127.0.0.1:3306/project
DB_USERNAME=root
DB_PASSWORD=

# --------------------------------------------
# Security Settings
# --------------------------------------------
HTTPS_ONLY=false
ALLOWED_ORIGINS=http://localhost:8080,https://localhost:8080

# --------------------------------------------
# Rate Limiting
# --------------------------------------------
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME_MINUTES=15
RESET_TIME_HOURS=1

# --------------------------------------------
# Logging
# --------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=

# --------------------------------------------
# Application Paths
# --------------------------------------------
# Upload directory for documents (maps to -Ddocument.upload.dir)
document.upload.dir=
# Bulk template base path (maps to -Dbulk.template.path)
bulk.template.path=

# --------------------------------------------
# LDAP Configuration
# --------------------------------------------
LDAP_ENABLED=true
LDAP_HOST=localhost
LDAP_PORT=10389
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_DN=ou=people,dc=example,dc=com
LDAP_GROUP_DN=ou=group,dc=example,dc=com
LDAP_USE_SSL=false
