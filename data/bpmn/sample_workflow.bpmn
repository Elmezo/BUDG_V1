<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                   xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                   xmlns:camunda="http://activiti.org/bpmn"
                   id="sample-workflow-1" 
                   targetNamespace="http://budg.example.com/workflow" 
                   exporter="budg-workflow" 
                   exporterVersion="1.0.0">
  
  <bpmn2:collaboration id="sample-collaboration" name="Change Request Approval Workflow">
    <bpmn2:participant id="workflow-participant" name="Roles" processRef="sample-process-1" />
  </bpmn2:collaboration>
  
  <bpmn2:process id="sample-process-1" name="Sample Approval Workflow" isExecutable="true">
    
    <!-- Lane Set with Roles -->
    <bpmn2:laneSet id="laneset-1">
      <bpmn2:lane id="lane-approver" name="24:Approver">
        <bpmn2:flowNodeRef>StartEvent_1</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>UserTask_Assessment</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>UserTask_Approval</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_Decision</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>UserTask_Implement</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>UserTask_Communicate</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_Implemented</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_Rejected</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="lane-requester" name="R01:Requestor" />
    </bpmn2:laneSet>
    
    <!-- Start Event -->
    <bpmn2:startEvent id="StartEvent_1" name="Start">
      <bpmn2:outgoing>Flow_Start_Assessment</bpmn2:outgoing>
    </bpmn2:startEvent>
    
    <!-- User Task 1: Assessment -->
    <bpmn2:userTask id="UserTask_Assessment" name="Assessment" camunda:dueDate="${dateTime().plusDays(5).toDate()}">
      <bpmn2:documentation>Perform all necessary work to review and assess the request and understand the impact, or rework proposal. Prepare recommendations.</bpmn2:documentation>
      <bpmn2:incoming>Flow_Start_Assessment</bpmn2:incoming>
      <bpmn2:incoming>Flow_Rework_Assessment</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Assessment_Approval</bpmn2:outgoing>
    </bpmn2:userTask>
    
    <!-- User Task 2: Approval -->
    <bpmn2:userTask id="UserTask_Approval" name="Approval" camunda:dueDate="${dateTime().plusDays(5).toDate()}">
      <bpmn2:documentation>Recommendations are assessed for completeness and approval. Should this request be implemented?</bpmn2:documentation>
      <bpmn2:incoming>Flow_Assessment_Approval</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Approval_Gateway</bpmn2:outgoing>
    </bpmn2:userTask>
    
    <!-- Exclusive Gateway: Decision -->
    <bpmn2:exclusiveGateway id="Gateway_Decision" name="Decision">
      <bpmn2:incoming>Flow_Approval_Gateway</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Approved</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Rejected</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Rework</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    
    <!-- User Task 3: Implementation (if approved) -->
    <bpmn2:userTask id="UserTask_Implement" name="Implement" camunda:dueDate="${dateTime().plusDays(5).toDate()}">
      <bpmn2:documentation>The approved request is implemented. All necessary communications are made. The change request can then be closed.</bpmn2:documentation>
      <bpmn2:incoming>Flow_Approved</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Implement_End</bpmn2:outgoing>
    </bpmn2:userTask>
    
    <!-- User Task 4: Communicate (if rejected) -->
    <bpmn2:userTask id="UserTask_Communicate" name="Communicate" camunda:dueDate="${dateTime().plusDays(5).toDate()}">
      <bpmn2:documentation>Change Request object should clearly outline reasons for rejection (e.g. in Resolution), requester and other interested parties should be informed. Ensure that these reasons are either recorded in comments or appended to the request, so we have a record. Request can then be closed.</bpmn2:documentation>
      <bpmn2:incoming>Flow_Rejected</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Communicate_End</bpmn2:outgoing>
    </bpmn2:userTask>
    
    <!-- End Event: Implemented -->
    <bpmn2:endEvent id="EndEvent_Implemented" name="End-Implement">
      <bpmn2:incoming>Flow_Implement_End</bpmn2:incoming>
    </bpmn2:endEvent>
    
    <!-- End Event: Rejected -->
    <bpmn2:endEvent id="EndEvent_Rejected" name="End-Rejected">
      <bpmn2:incoming>Flow_Communicate_End</bpmn2:incoming>
    </bpmn2:endEvent>
    
    <!-- Sequence Flows -->
    <bpmn2:sequenceFlow id="Flow_Start_Assessment" sourceRef="StartEvent_1" targetRef="UserTask_Assessment" />
    <bpmn2:sequenceFlow id="Flow_Assessment_Approval" sourceRef="UserTask_Assessment" targetRef="UserTask_Approval" />
    <bpmn2:sequenceFlow id="Flow_Approval_Gateway" sourceRef="UserTask_Approval" targetRef="Gateway_Decision" />
    
    <bpmn2:sequenceFlow id="Flow_Approved" name="Approved" sourceRef="Gateway_Decision" targetRef="UserTask_Implement">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"><![CDATA[${last_approval == 'Approved'}]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    
    <bpmn2:sequenceFlow id="Flow_Rejected" name="Rejected" sourceRef="Gateway_Decision" targetRef="UserTask_Communicate">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"><![CDATA[${last_approval == 'Rejected'}]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    
    <bpmn2:sequenceFlow id="Flow_Rework" name="Rework" sourceRef="Gateway_Decision" targetRef="UserTask_Assessment">
      <bpmn2:documentation>A decision cannot be made on the information available. The request is returned for additional actions. Ensure that reasons for rework are stated in the comments, or the analysis field on the summary tab.</bpmn2:documentation>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"><![CDATA[${last_approval == 'Rework'}]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    
    <bpmn2:sequenceFlow id="Flow_Implement_End" sourceRef="UserTask_Implement" targetRef="EndEvent_Implemented" />
    <bpmn2:sequenceFlow id="Flow_Communicate_End" sourceRef="UserTask_Communicate" targetRef="EndEvent_Rejected" />
    <bpmn2:sequenceFlow id="Flow_Rework_Assessment" sourceRef="Gateway_Decision" targetRef="UserTask_Assessment" />
    
  </bpmn2:process>
  
  <!-- BPMN Diagram (Visual Layout) -->
  <bpmndi:BPMNDiagram id="diagram-1">
    <bpmndi:BPMNPlane id="plane-1" bpmnElement="sample-collaboration">
      <bpmndi:BPMNShape id="shape-participant" bpmnElement="workflow-participant" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1100" height="500" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape-lane-approver" bpmnElement="lane-approver" isHorizontal="true">
        <dc:Bounds x="180" y="80" width="1070" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape-lane-requester" bpmnElement="lane-requester" isHorizontal="true">
        <dc:Bounds x="180" y="460" width="1070" height="120" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  
</bpmn2:definitions>
